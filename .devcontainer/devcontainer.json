{
  "name": "Tahto",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.88.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "CARGO_HOME": "/home/vscode/.cache/tahto/cargo",
    "npm_config_cache": "/home/vscode/.cache/tahto/npm"
  },
  "forwardPorts": [58100, 4321],
  "portsAttributes": {
    "58100": { "label": "Tahto node" },
    "4321": { "label": "Tahto Astro site" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
