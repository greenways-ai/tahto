(ns tahto.semantic.index-test
  (:require [std.foundation :refer :all]
            [std.lib.test :as test]
            [tahto.semantic.admission :as admission]
            [tahto.semantic.fixture :as fixture]
            [tahto.semantic.index :as index]
            [tahto.semantic.model :as semantic]
            [tahto.store.graph :as graph]
            [tahto.store.model :as model]))

(def missing-root
  "sha256:4444444444444444444444444444444444444444444444444444444444444444")

(test/print-results
 [(test/check
   "semantic index state is additive and absent before first admission"
   (let [state (model/empty-state)]
     [(has? state :semantic-indexes)
      (index/semantic-indexes state)
      (index/semantic-index-projection state fixture/index-root)])
   [false {} nil])

  (test/check
   "a complete index selects admitted versions and closes over semantic values"
   (let [state (fixture/admitted-state)
         result
         (index/admit-projected
          state
          (fixture/index-input fixture/semantic-index))
         next-state (fixture/result-state result)
         projection (get result :value)
         report
         (graph/closure-report-value next-state [fixture/index-root])]
     [(get result :ok)
      projection
      (get-in next-state [:edges fixture/index-root])
      (index/projection? projection)
      (get report :complete)
      (get report :overflow)
      (has? (into #{} (get report :visited)) fixture/value-a)
      (has? (into #{} (get report :visited)) fixture/value-b)])
   [true
    {:root fixture/index-root
     :entries
     [{:id "entity/a" :root fixture/envelope-a}
      {:id "entity/b" :root fixture/envelope-b}]}
    [fixture/envelope-a fixture/envelope-b]
    true true false true true])

  (test/check
   "every selected root must have one matching semantic projection"
   (let [state (fixture/admitted-state)
         missing-state
         (assoc state
                :semantic-objects
                (dissoc (admission/semantic-objects state)
                        fixture/envelope-b))
         missing
         (index/admit-projected
          missing-state
          (fixture/index-input fixture/semantic-index))
         mismatched-index
         {:protocol semantic/semantic-index-protocol
          :entries
          [{:id "entity/aa" :root fixture/envelope-a}
           {:id "entity/b" :root fixture/envelope-b}]}
         mismatched
         (index/admit-projected
          state
          (fixture/index-input mismatched-index))]
     [(fixture/error-code missing)
      (= missing-state (fixture/result-state missing))
      (fixture/error-code mismatched)
      (= state (fixture/result-state mismatched))])
   ["tahto.semantic/index-entry-not-admitted"
    true
    "tahto.semantic/index-entry-id-mismatch"
    true])

  (test/check
   "every v1 typed link resolves through the same exact index"
   (let [missing-link
         (assoc fixture/link-a-to-b :target-id "entity/missing")
         missing-object-a
         (assoc fixture/object-a :links [missing-link])
         missing-state
         (fixture/admitted-state-with
          missing-object-a fixture/object-b)
         missing
         (index/admit-projected
          missing-state
          (fixture/index-input fixture/semantic-index))
         wrong-root-link
         (assoc fixture/link-a-to-b :target-root fixture/envelope-a)
         wrong-root-object-a
         (assoc fixture/object-a :links [wrong-root-link])
         wrong-root-state
         (fixture/admitted-state-with
          wrong-root-object-a fixture/object-b)
         wrong-root
         (index/admit-projected
          wrong-root-state
          (fixture/index-input fixture/semantic-index))]
     [(fixture/error-code missing)
      (= missing-state (fixture/result-state missing))
      (fixture/error-code wrong-root)
      (= wrong-root-state (fixture/result-state wrong-root))])
   ["tahto.semantic/index-link-target-missing"
    true
    "tahto.semantic/index-link-root-mismatch"
    true])

  (test/check
   "the immutable index object must be installed and namespace-authorized"
   (let [state (fixture/admitted-state)
         missing-state
         (assoc state
                :objects
                (dissoc (get state :objects) fixture/index-root))
         missing
         (index/admit-projected
          missing-state
          (fixture/index-input fixture/semantic-index))
         key
         (model/namespace-key fixture/application fixture/namespace)
         unauthorized-state
         (assoc state
                :references
                (assoc (get state :references)
                       key
                       (model/set-remove
                        (get-in state [:references key])
                        fixture/index-root)))
         unauthorized
         (index/admit-projected
          unauthorized-state
          (fixture/index-input fixture/semantic-index))]
     [(fixture/error-code missing)
      (= missing-state (fixture/result-state missing))
      (fixture/error-code unauthorized)
      (= unauthorized-state (fixture/result-state unauthorized))])
   ["tahto.semantic/index-object-missing"
    true
    "tahto.semantic/index-object-not-authorized"
    true])

  (test/check
   "an index root cannot also be one of its semantic-object entries"
   (let [state (fixture/admitted-state)
         result
         (index/admit-projected
          state
          (fixture/index-input
           fixture/envelope-a
           fixture/semantic-index))]
     [(get result :ok)
      (fixture/error-code result)
      (= state (fixture/result-state result))])
   [false "tahto.semantic/index-root-dual-use" true])

  (test/check
   "index replay is exact and alternate projections or graph roles conflict"
   (let [object-a (assoc fixture/object-a :links [])
         object-b (assoc fixture/object-b :links [])
         state (fixture/admitted-state-with object-a object-b)
         full-index fixture/semantic-index
         narrow-index
         {:protocol semantic/semantic-index-protocol
          :entries [{:id "entity/a" :root fixture/envelope-a}]}
         input (fixture/index-input full-index)
         first (index/admit-projected state input)
         replay
         (index/admit-projected (fixture/result-state first) input)
         conflict
         (index/admit-projected
          (fixture/result-state first)
          (fixture/index-input narrow-index))
         occupied
         (assoc state
                :edges
                (assoc (get state :edges)
                       fixture/index-root
                       [fixture/envelope-a]))
         edge-conflict
         (index/admit-projected
          occupied
          (fixture/index-input full-index))]
     [(get replay :ok)
      (= (fixture/result-state first)
         (fixture/result-state replay))
      (fixture/error-code conflict)
      (= (fixture/result-state first)
         (fixture/result-state conflict))
      (fixture/error-code edge-conflict)
      (= occupied (fixture/result-state edge-conflict))])
   [true true
    "tahto.semantic/index-projection-conflict" true
    "tahto.semantic/index-edge-conflict" true])

  (test/check
   "candidate index closure rejects missing and overflowed descendants"
   (let [state (fixture/base-installed-state)
         missing
         (index/candidate-closure-error
          state fixture/index-root [missing-root])
         overflow-state
         (assoc state
                :limits
                (assoc (get state :limits) :max-closure-objects 1))
         overflow
         (index/candidate-closure-error
          overflow-state
          fixture/index-root
          [fixture/envelope-a])]
     [(get missing :code)
      (get-in missing [:details :missing])
      (get overflow :code)])
   ["tahto.semantic/index-closure-incomplete"
    [missing-root]
    "tahto.semantic/index-closure-overflow"])

  (test/check
   "index inputs are closed and durable projections contain no authority"
   (let [state (fixture/admitted-state)
         input (fixture/index-input fixture/semantic-index)
         extended
         (index/admit-projected state (assoc input :provider "memory"))
         admitted (index/admit-projected state input)
         projection (get admitted :value)]
     [(fixture/error-code extended)
      (= state (fixture/result-state extended))
      (index/projection? projection)
      (has? projection :application)
      (has? projection :namespace)
      (has? projection :collection)
      (has? projection :provider)
      (has? projection :path)
      (has? projection :source-handle)])
   ["tahto.semantic/index-input-invalid"
    true true false false false false false false])])
