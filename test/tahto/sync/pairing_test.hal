(ns tahto.sync.pairing-test
  (:config {})
  (:require
            [tahto.store.model :as model]
            [tahto.sync.pairing :as pairing]))

(def token-digest
  "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")

(def approval-digest
  "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")

(defn invitation
  []
  {:protocol pairing/invitation-protocol
   :id "invite.one"
   :node "node.home"
   :token-digest token-digest
   :approval-digest approval-digest
   :created-at "2026-08-09T00:00:00Z"
   :expires-at "2026-08-09T00:05:00Z"
   :created-seconds 1786233600
   :expires-seconds 1786233900
   :status "open"})

(defn acceptance
  [token accepted-at]
  {:protocol pairing/acceptance-protocol
   :invitation "invite.one"
   :token-digest token
   :accepted-at accepted-at
   :accepted-seconds
   (if (= accepted-at "2026-08-09T00:05:00Z")
     1786233900
     (if (= accepted-at "2026-08-09T00:02:00Z")
       1786233720
       1786233660))
   :device
   {:protocol model/device-protocol
    :id "device.browser"
    :node "node.home"
    :public-key "p256:browser-public-key"
    :status "enrolled"
    :enrolled-at accepted-at}})

(defn issued-state
  []
  (get (pairing/issue (model/empty-state) (invitation)) :state))

(defn prepare-request
  []
  {:protocol pairing/prepare-protocol
   :invitation "invite.one"
   :token-digest token-digest
   :device "device.browser"
   :public-key "p256:browser-public-key"
   :algorithm "p256-sha256"
   :prepared-at "2026-08-09T00:01:00Z"
   :prepared-seconds 1786233660})

(defn complete-request
  [intent]
  {:protocol pairing/complete-protocol
   :token-digest token-digest
   :accepted-at "2026-08-09T00:02:00Z"
   :accepted-seconds 1786233720
   :intent intent
   :intent-verification
   {:protocol pairing/intent-verification-protocol
    :verified true
    :intent-digest
    "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    :intent intent
    :device "device.browser"
    :public-key "p256:browser-public-key"
    :algorithm "p256-sha256"}})

[(test-check
   "pairing consumes one invitation and grants identity only"
   (let [result
         (pairing/accept
          (issued-state)
          (acceptance token-digest "2026-08-09T00:01:00Z"))]
     [(get result :ok)
      (get-in result [:value :administrator])
      (get-in result [:value :grants])
      (get-in result [:state :pairing-invitations "invite.one" :status])
      (get-in result [:state :devices "device.browser" :status])])
   [true false [] "consumed" "enrolled"])

  (test-check
   "an invitation is strictly one-time"
   (let [first
         (pairing/accept
          (issued-state)
          (acceptance token-digest "2026-08-09T00:01:00Z"))
         second
         (pairing/accept
          (get first :state)
          (acceptance token-digest "2026-08-09T00:02:00Z"))]
     (get-in second [:error :code]))
   "tahto.pairing/invitation-consumed")

  (test-check
   "the raw invitation token is never stored"
   (let [state (issued-state)]
     [(has? (get-in state [:pairing-invitations "invite.one"])
            :token)
      (get-in state [:pairing-invitations "invite.one" :token-digest])])
   [false token-digest])

  (test-check
   "the wrong token digest is rejected without consuming the invitation"
   (let [wrong
         "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
         result
         (pairing/accept
          (issued-state)
          (acceptance wrong "2026-08-09T00:01:00Z"))]
     [(get-in result [:error :code])
      (get-in result [:state :pairing-invitations "invite.one" :status])])
   ["tahto.pairing/token-invalid" "open"])

  (test-check
   "an expired invitation is rejected"
   (get-in
    (pairing/accept
     (issued-state)
     (acceptance token-digest "2026-08-09T00:05:00Z"))
    [:error :code])
   "tahto.pairing/invitation-expired")

  (test-check
   "prepare binds one open invitation to the exact node device and P-256 key"
   (let [result (pairing/prepare (issued-state) (prepare-request))
         intent (get result :value)]
     [(get result :ok)
      (pairing/intent? intent)
      (get intent :node)
      (get intent :device)
      (get intent :public-key)
      (= intent
         (get-in result [:state :pairing-invitations "invite.one" :intent]))])
   [true true "node.home" "device.browser" "p256:browser-public-key" true])

  (test-check
   "complete atomically consumes the invite and replays an exact lost result"
   (let [state (issued-state)
         prepared (pairing/prepare state (prepare-request))
         request (complete-request (get prepared :value))
         first (pairing/complete (get prepared :state) request)
         replay (pairing/complete (get first :state) request)]
     [(get first :ok)
      (get-in first [:state :pairing-invitations "invite.one" :status])
      (get-in first [:state :devices "device.browser" :status])
      (get-in first [:value :administrator])
      (get-in first [:value :grants])
      (get replay :ok)
      (= (get first :state) (get replay :state))
      (= (get first :value) (get replay :value))])
   [true "consumed" "enrolled" false [] true true true])

  (test-check
   "complete rejects a tampered intent before consuming the invitation"
   (let [state (issued-state)
         prepared (pairing/prepare state (prepare-request))
         intent (get prepared :value)
         request (complete-request (assoc intent :device "device.other"))
         result (pairing/complete (get prepared :state) request)]
     [(get-in result [:error :code])
      (= (get prepared :state) (get result :state))])
   ["tahto.pairing/intent-mismatch" true])

  (test-check
   "a prepared intent is replayable but cannot be rebound or disclosed by another token"
   (let [state (issued-state)
         request (prepare-request)
         first (pairing/prepare state request)
         prepared-state (get first :state)
         replay (pairing/prepare prepared-state request)
         rebound
         (pairing/prepare
          prepared-state
          (assoc request :device "device.other"))
         wrong-token
         (pairing/prepare
          prepared-state
          (assoc request
                 :token-digest
                 "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"))]
     [(get replay :ok)
      (= (get first :value) (get replay :value))
      (= prepared-state (get replay :state))
      (get-in rebound [:error :code])
      (get-in wrong-token [:error :code])])
   [true true true "tahto.pairing/intent-conflict" "tahto.pairing/token-invalid"])]
