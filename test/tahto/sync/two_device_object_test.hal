(ns tahto.sync.two-device-object-test
  (:require [std.foundation :refer :all]
            [hoplite.response-source :as portable]
            [std.lib.test :as test]
            [tahto.protocol.validate :as validate]
            [tahto.store.capability :as capability]
            [tahto.store.model :as model]
            [tahto.store.response-source :as response-source]
            [tahto.sync.device :as device]))

(def node "node.home")
(def application "fixture.transfer")
(def namespace-id "world.shared")
(def collection "objects")
(def device-a "device.a")
(def device-b "device.b")
(def public-key-a "ed25519:device-a-public-key")
(def public-key-b "ed25519:device-b-public-key")

(def object-root
  "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(def approval-a
  "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
(def approval-b
  "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc")
(def publish-request-root
  "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")
(def publish-result-root
  "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee")
(def read-request-root
  "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
(def read-result-root
  "sha256:1111111111111111111111111111111111111111111111111111111111111111")
(def revoke-root
  "sha256:2222222222222222222222222222222222222222222222222222222222222222")

(def object-size 9)

(defn result-state
  [result]
  (get result :state))

(defn error-code
  [result]
  (get-in result [:error :code]))

(defn device-record
  [id public-key]
  {:protocol model/device-protocol
   :id id
   :node node
   :public-key public-key
   :status "enrolled"
   :enrolled-at "2026-08-08T00:00:00Z"})

(defn enrolment
  [record approval]
  {:protocol validate/device-enrolment-protocol
   :approved true
   :node node
   :approval-digest approval
   :device record})

(defn enrolled-state
  []
  (let [first
        (device/enrol-device
         (model/empty-state)
         (enrolment (device-record device-a public-key-a) approval-a))
        second
        (device/enrol-device
         (result-state first)
         (enrolment (device-record device-b public-key-b) approval-b))]
    (result-state second)))

(defn request-proof
  [id public-key operation request-root nonce idempotency-key timestamp]
  {:protocol validate/request-verification-protocol
   :verified true
   :device id
   :public-key public-key
   :operation operation
   :application application
   :namespace namespace-id
   :collection collection
   :request-digest request-root
   :nonce nonce
   :idempotency-key idempotency-key
   :timestamp timestamp})

(defn authority
  [proof]
  {:protocol validate/request-authority-protocol
   :allowed true
   :device (get proof :device)
   :operation (get proof :operation)
   :application (get proof :application)
   :namespace (get proof :namespace)
   :collection (get proof :collection)
   :request-digest (get proof :request-digest)
   :decision-root (get proof :request-digest)
   :observed-at (get proof :timestamp)})

(defn admit
  [state id public-key operation request-root nonce idempotency-key timestamp]
  (let [proof
        (request-proof id public-key operation request-root
                       nonce idempotency-key timestamp)]
    (device/admit-request state proof (authority proof))))

(defn complete
  [state id idempotency-key request-root result-root timestamp]
  (device/complete-request
   state
   {:device id
    :idempotency-key idempotency-key
    :request-digest request-root
    :result-digest result-root
    :completed-at timestamp}))

(defn install-published-object
  [state]
  (assoc
   (assoc state
          :objects
          (assoc (get state :objects)
                 object-root
                 (model/object-record object-root object-size)))
   :references
   (assoc (get state :references)
          (model/namespace-key application namespace-id)
          #{object-root})))

(defn source-result
  [handle]
  {:protocol capability/result-protocol
   :operation "object/open-source"
   :source-handle handle
   :digest object-root
   :offset 0
   :length object-size})

(defn revocation
  []
  {:protocol validate/device-revocation-protocol
   :approved true
   :node node
   :device device-b
   :revoked-at "2026-08-08T00:30:00Z"
   :approval-digest revoke-root})

(test/print-results
 [(test/check
   "two devices publish and read one immutable object under supplied authority"
   (let [initial (enrolled-state)
         publish
         (admit initial
                device-a public-key-a "object.upload"
                publish-request-root
                "nonce-publish-a-0001"
                "request-publish-a-0001"
                "2026-08-08T00:01:00Z")
         installed
         (install-published-object (result-state publish))
         published
         (complete installed
                   device-a
                   "request-publish-a-0001"
                   publish-request-root
                   publish-result-root
                   "2026-08-08T00:02:00Z")
         read
         (admit (result-state published)
                device-b public-key-b "object.read"
                read-request-root
                "nonce-read-b-0001"
                "request-read-b-0001"
                "2026-08-08T00:03:00Z")
         opened
         (response-source/open-with
          (result-state read)
          {:application application
           :namespace namespace-id
           :digest object-root
           :start 0
           :end object-size}
          (fn [service operation request]
            (if (and (= capability/host-service service)
                     (= "object/open-source" operation)
                     (= object-root (get request :digest))
                     (= 0 (get request :offset))
                     (= object-size (get request :length)))
              (source-result 41)
              nil)))
         descriptor (get opened :value)
         completed
         (complete (result-state opened)
                   device-b
                   "request-read-b-0001"
                   read-request-root
                   read-result-root
                   "2026-08-08T00:04:00Z")]
     [(get publish :ok)
      (get published :ok)
      (get read :ok)
      (get opened :ok)
      (= (result-state read) (result-state opened))
      (portable/response-source? descriptor)
      (get descriptor :service)
      (get descriptor :source-handle)
      (get descriptor :offset)
      (get descriptor :length)
      (get completed :ok)
      (get-in completed [:value :status])])
   [true true true true true true
    "hoplite.blob" 41 0 object-size true "completed"])

  (test/check
   "revocation denies the next request before any object source can open"
   (let [initial (install-published-object (enrolled-state))
         revoked (device/revoke-device initial (revocation))
         denied
         (admit (result-state revoked)
                device-b public-key-b "object.read"
                read-request-root
                "nonce-read-b-0002"
                "request-read-b-0002"
                "2026-08-08T00:31:00Z")]
     [(get revoked :ok)
      (get denied :ok)
      (error-code denied)
      (= (result-state revoked) (result-state denied))])
   [true false "tahto.device/device-revoked" true])

  (test/check
   "authority and request evidence remain independently substitutable only by exact match"
   (let [state (enrolled-state)
         proof
         (request-proof device-b public-key-b "object.read"
                        read-request-root
                        "nonce-read-b-0003"
                        "request-read-b-0003"
                        "2026-08-08T00:10:00Z")
         denied
         (device/admit-request
          state
          proof
          (assoc (authority proof) :collection "other"))]
     [(get denied :ok)
      (error-code denied)
      (= state (get denied :state))])
   [false "tahto.device/request-authority-mismatch" true])])
