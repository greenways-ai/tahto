(ns tahto.store.capability-test
  (:require [std.foundation :refer :all]
            [std.lib.test :as test]
            [tahto.store.capability :as capability]
            [tahto.store.host :as host]))

(def digest
  "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")

(def open-effect
  (host/effect
   "upload/open"
   {:upload-id "upload.a"
    :digest digest
    :size 12
    :media-type "application/octet-stream"}))

(def append-effect
  (host/effect
   "upload/append"
   {:upload-id "upload.a"
    :offset 4
    :length 5
    :body-handle 17}))

(def abort-effect
  (host/effect
   "upload/abort"
   {:upload-id "upload.a"}))

(def verify-effect
  (host/effect
   "upload/verify-install"
   {:upload-id "upload.a"
    :digest digest
    :size 12}))

(def range-effect
  (host/effect
   "object/read-range"
   {:digest digest
    :start 2
    :end 9}))

(def manifest-effect
  (host/effect
   "manifest/verify"
   {:digest digest
    :max-chunks 8}))

(def open-result
  {:protocol capability/result-protocol
   :operation "staging/open"
   :staging-key "upload.a"
   :opened true
   :offset 0})

(def append-result
  {:protocol capability/result-protocol
   :operation "staging/append-from-source"
   :staging-key "upload.a"
   :consumed true
   :offset 9
   :length 5})

(def verify-result
  {:protocol capability/result-protocol
   :operation "staging/verify-commit"
   :staging-key "upload.a"
   :verified true
   :committed true
   :digest digest
   :size 12})

(def source-result
  {:protocol capability/result-protocol
   :operation "object/open-source"
   :source-handle 31
   :digest digest
   :offset 2
   :length 7})

(defn error-code
  [result]
  (get-in result [:error :code]))

(test/print-results
 [(test/check
   "Tahto effects map to one application-neutral Host/call shape"
   (let [open-call (capability/call-from-effect open-effect)
         append-call (capability/call-from-effect append-effect)
         abort-call (capability/call-from-effect abort-effect)
         verify-call (capability/call-from-effect verify-effect)
         range-call (capability/call-from-effect range-effect)]
     [(get open-call :service)
      (get open-call :operation)
      (get append-call :operation)
      (get abort-call :operation)
      (get verify-call :operation)
      (get range-call :operation)
      (count (get open-call :arguments))
      (has? open-call :native-abi)
      (every? capability/host-call?
              [open-call append-call abort-call verify-call range-call])])
   ["hoplite.blob"
    "staging/open"
    "staging/append-from-source"
    "staging/abort"
    "staging/verify-commit"
    "object/open-source"
    1
    false
    true])

  (test/check
   "the HAL adapter separates logical staging keys from work-scoped sources"
   (let [open-request
         (capability/call-request
          (capability/call-from-effect open-effect))
         append-request
         (capability/call-request
          (capability/call-from-effect append-effect))]
     [(get open-request :staging-key)
      (get open-request :expected-digest)
      (get open-request :expected-size)
      (get append-request :staging-key)
      (get append-request :offset)
      (get append-request :length)
      (get append-request :source-handle)
      (has? append-request :body-handle)
      (has? append-request :bytes)
      (has? append-request :path)])
   ["upload.a" digest 12 "upload.a" 4 5 17 false false false])

  (test/check
   "range plans become offset-length source requests"
   (let [request
         (capability/call-request
          (capability/call-from-effect range-effect))]
     [(get request :digest)
      (get request :offset)
      (get request :length)
      (has? request :start)
      (has? request :end)])
   [digest 2 7 false false])

  (test/check
   "application call plans cannot select a native ABI or driver"
   (let [call (capability/call-from-effect append-effect)]
     [(capability/host-call? call)
      (capability/host-call?
       (assoc call :native-abi "request-selected"))
      (capability/host-call?
       (assoc call :driver "sqlite"))])
   [true false false])

  (test/check
   "generic requests reject paths raw bodies and extra authority"
   (let [request
         (capability/call-request
          (capability/call-from-effect append-effect))]
     [(capability/request? request)
      (capability/request? (assoc request :path "/tmp/unsafe"))
      (capability/request? (assoc request :bytes [1 2 3]))
      (capability/request? (assoc request :credential "secret"))])
   [true false false false])

  (test/check
   "unsupported and malformed Tahto effects fail before host dispatch"
   (let [unsupported (capability/prepare {} manifest-effect)
         malformed
         (capability/prepare
          {}
          {:protocol host/effect-protocol
           :operation "upload/append"
           :request {:upload-id "upload.a"
                     :offset 0
                     :length 1
                     :body-handle 0}})]
     [(get unsupported :ok)
      (error-code unsupported)
      (get malformed :ok)
      (error-code malformed)
      (capability/call-from-effect manifest-effect)])
   [false
    "tahto.capability/effect-unsupported"
    false
    "tahto.capability/effect-invalid"
    nil])

  (test/check
   "prepared calls preserve state and expose only the generic call plan"
   (let [state {:marker "unchanged"}
         result (capability/prepare state append-effect)]
     [(get result :ok)
      (get result :state)
      (capability/host-call? (get result :value))
      (get-in result [:value :service])])
   [true {:marker "unchanged"} true "hoplite.blob"])

  (test/check
   "generic results are exact operation-specific records"
   [(capability/result? verify-result)
    (capability/result?
     (assoc verify-result :destination "/tmp/object"))
    (capability/result?
     (assoc verify-result :operation "upload/verify-install"))]
   [true false false])

  (test/check
   "generic results must match the exact planned call"
   (let [call (capability/call-from-effect verify-effect)]
     [(capability/result-matches-call? call verify-result)
      (capability/result-matches-call?
       call
       (assoc verify-result :size 13))
      (capability/result-matches-call?
       call
       (assoc verify-result :staging-key "upload.b"))])
   [true false false])

  (test/check
   "accepted generic results preserve state only after exact validation"
   (let [state {:marker "unchanged"}
         call (capability/call-from-effect append-effect)
         accepted (capability/accept-result state call append-result)
         malformed
         (capability/accept-result
          state call (assoc append-result :path "/tmp/unsafe"))
         mismatched
         (capability/accept-result
          state call (assoc append-result :offset 8))]
     [(get accepted :ok)
      (get accepted :state)
      (get accepted :value)
      (get malformed :ok)
      (error-code malformed)
      (get mismatched :ok)
      (error-code mismatched)])
   [true
    {:marker "unchanged"}
    append-result
    false
    "tahto.capability/result-invalid"
    false
    "tahto.capability/result-mismatch"])

  (test/check
   "an injected HAL capability executes the same closed call contract"
   (let [state {:marker "unchanged"}
         result
         (capability/execute-with
          state
          append-effect
          (fn [service operation request]
            (if
             (and (= "hoplite.blob" service)
                  (= "staging/append-from-source" operation)
                  (= 17 (get request :source-handle))
                  (= 5 (get request :length)))
             append-result
             nil)))]
     [(get result :ok)
      (get result :state)
      (get result :value)])
   [true {:marker "unchanged"} append-result])

  (test/check
   "injected providers cannot bypass request and result matching"
   (let [invalid-effect
         (capability/execute-with
          {}
          manifest-effect
          (fn [service operation request] open-result))
         wrong-result
         (capability/execute-with
          {}
          append-effect
          (fn [service operation request] open-result))]
     [(get invalid-effect :ok)
      (error-code invalid-effect)
      (get wrong-result :ok)
      (error-code wrong-result)])
   [false
    "tahto.capability/effect-unsupported"
    false
    "tahto.capability/result-mismatch"])

  (test/check
   "staging open may resume only inside the declared object size"
   (let [call (capability/call-from-effect open-effect)
         result {:protocol capability/result-protocol
                 :operation "staging/open"
                 :staging-key "upload.a"
                 :opened true
                 :offset 5}]
     [(capability/result-matches-call? call result)
      (capability/result-matches-call?
       call
       (assoc result :offset 13))])
   [true false])

  (test/check
   "verified generic commits translate back into Tahto results in HAL"
   (let [translated
         (capability/verified-install-result verify-effect verify-result)]
     [(get translated :protocol)
      (get translated :operation)
      (get translated :verified)
      (get translated :installed)
      (get translated :upload-id)
      (get translated :digest)
      (get translated :size)
      (host/verified-install?
       translated
       {:id "upload.a" :digest digest :size 12})])
   [host/result-protocol
    "upload/verify-install"
    true
    true
    "upload.a"
    digest
    12
    true])

  (test/check
   "generic immutable sources translate to bounded Tahto range results"
   (let [translated
         (capability/opened-source-result range-effect source-result)]
     [(get translated :operation)
      (get translated :start)
      (get translated :end)
      (get translated :length)
      (get translated :source-handle)
      (host/opened-range? translated digest 2 9)])
   ["object/read-range" 2 9 7 31 true])

  (test/check
   "mismatched generic results never cross the Tahto result boundary"
   [(capability/verified-install-result
     verify-effect
     (assoc verify-result :digest
            "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))
    (capability/opened-source-result
     range-effect
     (assoc source-result :length 8))
    (capability/verified-install-result open-effect verify-result)]
   [nil nil nil])])
