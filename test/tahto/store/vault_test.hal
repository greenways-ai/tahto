(ns tahto.store.vault-test
  (:config {})
  (:require [std.foundation :refer :all]
            [std.lib.test :as test]
            [tahto.store.graph :as graph]
            [tahto.store.host :as store-host]
            [tahto.store.model :as model]
            [tahto.store.vault :as vault]))

(def digest-a
  "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(def digest-b
  "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
(def digest-c
  "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc")

(defn result-state
  [result]
  (get result :state))

(defn error-code
  [result]
  (get-in result [:error :code]))

(defn upload-object
  [state upload-id application namespace digest size]
  (let [begun (vault/begin-upload
               state
               {:upload-id upload-id
                :application application
                :namespace namespace
                :digest digest
                :size size
                :media-type "application/octet-stream"})
        appended (if (= size 0)
                   begun
                   (vault/append-upload
                    (result-state begun)
                    {:upload-id upload-id
                     :offset 0
                     :length size
                     :body-handle 42}))
        requested (vault/request-install
                   (result-state appended)
                   {:upload-id upload-id})]
    (vault/accept-install
     (result-state requested)
     {:protocol store-host/result-protocol
      :operation "upload/verify-install"
      :upload-id upload-id
      :digest digest
      :size size
      :verified true
      :installed true})))

(test/print-results
 [(test/check
   "canonical digests are lower-case sha256 identifiers"
   [(model/canonical-digest? digest-a)
    (model/canonical-digest?
     "sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")
    (model/canonical-digest? "../objects/a")]
   [true false false])

  (test/check
   "application-facing identifiers follow the TAHTO-2 core vocabulary"
   [(model/identifier? "app.example")
    (model/identifier? "profile/primary")
    (model/identifier? "App.Example")
    (model/identifier? ".hidden")
    (model/identifier?
     "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")]
   [true true false false false])

  (test/check
   "the host boundary rejects paths, raw bytes and non-numeric handles"
   [(store-host/effect?
     (store-host/effect
      "upload/open"
      {:upload-id "upload-1"
       :digest digest-a
       :size 8
       :media-type "application/octet-stream"}))
    (store-host/effect?
     (store-host/effect
      "upload/open"
      {:upload-id "upload-1"
       :digest digest-a
       :size 8
       :media-type "application/octet-stream"
       :path "/tmp/a"}))
    (store-host/effect?
     (store-host/effect
      "upload/append"
      {:upload-id "upload-1"
       :offset 0
       :length 8
       :body-handle "body-42"}))]
   [true false false])

  (test/check
   "an upload reserves its full logical namespace quota"
   (let [state (model/empty-state {:default-namespace-quota-bytes 10})
         first-result
         (vault/begin-upload
          state
          {:upload-id "upload-1"
           :application "app"
           :namespace "ns"
           :digest digest-a
           :size 7
           :media-type "application/octet-stream"})
         second-result
         (vault/begin-upload
          (result-state first-result)
          {:upload-id "upload-2"
           :application "app"
           :namespace "ns"
           :digest digest-b
           :size 4
           :media-type "application/octet-stream"})]
     [(get first-result :ok)
      (get second-result :ok)
      (error-code second-result)])
   [true false "tahto.store/quota-exceeded"])

  (test/check
   "empty immutable objects can complete without an append"
   (let [installed (upload-object (model/empty-state)
                                  "upload-empty" "app" "ns" digest-a 0)]
     [(get installed :ok)
      (get (model/stored-object (result-state installed) digest-a) :size)])
   [true 0])

  (test/check
   "append rejects stale offsets before issuing a host write"
   (let [begun
         (vault/begin-upload
          (model/empty-state)
          {:upload-id "upload-1"
           :application "app"
           :namespace "ns"
           :digest digest-a
           :size 8
           :media-type "application/octet-stream"})
         stale
         (vault/append-upload
          (result-state begun)
          {:upload-id "upload-1"
           :offset 1
           :length 4
           :body-handle 42})]
     [(get stale :ok)
      (error-code stale)
      (get stale :effects)])
   [false "tahto.store/stale-upload-offset" []])

  (test/check
   "large object bytes stay behind an opaque Hoplite resource handle"
   (let [begun
         (vault/begin-upload
          (model/empty-state)
          {:upload-id "upload-1"
           :application "app"
           :namespace "ns"
           :digest digest-a
           :size 8
           :media-type "application/octet-stream"})
         appended
         (vault/append-upload
          (result-state begun)
          {:upload-id "upload-1"
           :offset 0
           :length 8
           :body-handle 42})
         effect (first (get appended :effects))]
     [(get-in effect [:request :body-handle])
      (has? (get effect :request) :bytes)
      (has? (get effect :request) :path)
      (store-host/effect? effect)])
   [42 false false true])

  (test/check
   "installation is authoritative only after a matching host proof"
   (let [begun
         (vault/begin-upload
          (model/empty-state)
          {:upload-id "upload-1"
           :application "app"
           :namespace "ns"
           :digest digest-a
           :size 8
           :media-type "application/octet-stream"})
         appended
         (vault/append-upload
          (result-state begun)
          {:upload-id "upload-1"
           :offset 0
           :length 8
           :body-handle 42})
         requested
         (vault/request-install (result-state appended) {:upload-id "upload-1"})
         rejected
         (vault/accept-install
          (result-state requested)
          {:protocol store-host/result-protocol
           :operation "upload/verify-install"
           :upload-id "upload-1"
           :digest digest-b
           :size 8
           :verified true
           :installed true})]
     [(get rejected :ok)
      (error-code rejected)
      (nil? (model/stored-object (result-state rejected) digest-a))])
   [false "tahto.store/install-verification-failed" true])

  (test/check
   "verified installation creates an object and namespace reference"
   (let [installed (upload-object (model/empty-state)
                                  "upload-1" "app" "ns" digest-a 8)
         state (result-state installed)]
     [(get installed :ok)
      (get (model/stored-object state digest-a) :protocol)
      (get (model/stored-object state digest-a) :size)
      (get (model/stored-object state digest-a) :encoding)
      (has? (model/stored-object state digest-a) :media-type)
      (model/namespace-reference? state "app" "ns" digest-a)
      (nil? (model/upload state "upload-1"))])
   [true model/object-protocol 8 "identity" false true true])

  (test/check
   "aborting an upload releases its reservation and emits bounded cleanup"
   (let [begun
         (vault/begin-upload
          (model/empty-state {:default-namespace-quota-bytes 8})
          {:upload-id "upload-1"
           :application "app"
           :namespace "ns"
           :digest digest-a
           :size 8
           :media-type "application/octet-stream"})
         aborted
         (vault/abort-upload (result-state begun) {:upload-id "upload-1"})]
     [(model/namespace-reservations
       (result-state aborted) "app" "ns")
      (get-in aborted [:effects 0 :operation])
      (store-host/effect? (first (get aborted :effects)))])
   [0 "upload/abort" true])

  (test/check
   "existence negotiation preserves order for one authorized namespace"
   (let [installed-a (upload-object (model/empty-state)
                                    "upload-a" "app" "ns" digest-a 8)
         installed-b (upload-object (result-state installed-a)
                                    "upload-b" "app" "ns" digest-b 4)
         result
         (vault/negotiate
          (result-state installed-b)
          {:application "app"
           :namespace "ns"
           :digests [digest-b digest-a digest-b digest-c]})]
     (get result :value))
   {:present [digest-b digest-a]
    :missing [digest-c]})

  (test/check
   "existence negotiation is bounded before digest traversal"
   (let [result
         (vault/negotiate
          (model/empty-state {:max-negotiate-digests 2})
          {:application "app"
           :namespace "ns"
           :digests [digest-a digest-b digest-c]})]
     [(get result :ok) (error-code result) (get result :effects)])
   [false "tahto.store/digest-list-too-large" []])

  (test/check
   "object presence is not disclosed across namespaces or applications"
   (let [installed (upload-object (model/empty-state)
                                  "upload-a" "app-a" "ns-a" digest-a 8)
         state (result-state installed)
         other-namespace
         (vault/negotiate
          state
          {:application "app-a"
           :namespace "ns-b"
           :digests [digest-a]})
         other-application
         (vault/negotiate
          state
          {:application "app-b"
           :namespace "ns-b"
           :digests [digest-a]})]
     [(get other-namespace :value)
      (get other-application :value)])
   [{:present [] :missing [digest-a]}
    {:present [] :missing [digest-a]}])

  (test/check
   "another application gains authority only after a full verified upload"
   (let [installed (upload-object (model/empty-state)
                                  "upload-a" "app-a" "ns-a" digest-a 8)
         verified-again
         (upload-object (result-state installed)
                        "upload-b" "app-b" "ns-b" digest-a 8)
         state (result-state verified-again)]
     [(get verified-again :ok)
      (model/namespace-reference? state "app-a" "ns-a" digest-a)
      (model/namespace-reference? state "app-b" "ns-b" digest-a)
      (count (get state :objects))])
   [true true true 1])

  (test/check
   "global deduplication cannot bypass logical namespace quota"
   (let [installed (upload-object (model/empty-state)
                                  "upload-a" "app-a" "ns-a" digest-a 8)
         limited
         (vault/set-quota
          (result-state installed)
          {:application "app-b" :namespace "ns-b" :quota-bytes 7})
         begun
         (vault/begin-upload
          (result-state limited)
          {:upload-id "upload-b"
           :application "app-b"
           :namespace "ns-b"
           :digest digest-a
           :size 8
           :media-type "application/octet-stream"})]
     [(get begun :ok)
      (error-code begun)
      (get begun :effects)
      (get-in (graph/namespace-accounting
               (result-state begun) "app-b" "ns-b")
              [:value :bytes])])
   [false "tahto.store/quota-exceeded" [] 0])

  (test/check
   "range plans enforce namespace authority and bounded half-open offsets"
   (let [installed (upload-object
                    (model/empty-state {:max-range-bytes 4})
                    "upload-1" "app-a" "ns-a" digest-a 8)
         state (result-state installed)
         valid
         (vault/plan-range
          state
          {:application "app-a" :namespace "ns-a"
           :digest digest-a :start 2 :end 6})
         forbidden
         (vault/plan-range
          state
          {:application "app-b" :namespace "ns-b"
           :digest digest-a :start 2 :end 6})
         absent
         (vault/plan-range
          state
          {:application "app-b" :namespace "ns-b"
           :digest digest-c :start 2 :end 6})
         too-large
         (vault/plan-range
          state
          {:application "app-a" :namespace "ns-a"
           :digest digest-a :start 2 :end 7})]
     [(get valid :ok)
      (get-in valid [:effects 0 :request])
      (error-code forbidden)
      (error-code absent)
      (error-code too-large)])
   [true
    {:digest digest-a :start 2 :end 6}
    "tahto.store/object-out-of-scope"
    "tahto.store/object-out-of-scope"
    "tahto.store/range-too-large"])])
