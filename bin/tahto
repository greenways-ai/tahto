#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
HOPLITE=${HOPLITE:-hoplite}
ORIGIN=${TAHTO_ORIGIN:-http://127.0.0.1:58100}
ACTION=${1:-run}
if [ "$#" -gt 0 ]; then
  shift
fi

sha256_text() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | cut -d ' ' -f 1
  else
    sha256sum | cut -d ' ' -f 1
  fi
}

format_epoch() {
  if date -u -r "$1" '+%Y-%m-%dT%H:%M:%SZ' >/dev/null 2>&1; then
    date -u -r "$1" '+%Y-%m-%dT%H:%M:%SZ'
  else
    date -u -d "@$1" '+%Y-%m-%dT%H:%M:%SZ'
  fi
}

base64url_text() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

case "$ACTION" in
  run|foreground)
    exec "$HOPLITE" serve foreground --profile server --mode prod "$ROOT"
    ;;
  dev)
    exec "$HOPLITE" serve foreground --profile server --mode dev "$ROOT"
    ;;
  check)
    exec "$HOPLITE" serve check --profile server --mode prod "$ROOT"
    ;;
  build)
    exec "$HOPLITE" serve build --profile server --mode prod "$ROOT"
    ;;
  start|status|reload|stop|install|uninstall)
    exec "$HOPLITE" serve "$ACTION" --profile server --mode prod "$ROOT"
    ;;
  doctor)
    curl --fail --silent --show-error "$ORIGIN/tahto/0-alpha/health"
    printf '\n'
    curl --fail --silent --show-error "$ORIGIN/tahto/0-alpha/status"
    printf '\n'
    ;;
  invite)
    command -v openssl >/dev/null 2>&1 || {
      printf 'tahto: invite requires openssl\n' >&2
      exit 1
    }
    NOW_SECONDS=$(date -u '+%s')
    TTL_SECONDS=${TAHTO_INVITATION_TTL_SECONDS:-300}
    case "$TTL_SECONDS" in
      ''|*[!0-9]*)
        printf 'tahto: TAHTO_INVITATION_TTL_SECONDS must be a positive integer\n' >&2
        exit 2
        ;;
    esac
    [ "$TTL_SECONDS" -gt 0 ] || {
      printf 'tahto: TAHTO_INVITATION_TTL_SECONDS must be positive\n' >&2
      exit 2
    }
    EXPIRES_SECONDS=$((NOW_SECONDS + TTL_SECONDS))
    CREATED_AT=$(format_epoch "$NOW_SECONDS")
    EXPIRES_AT=$(format_epoch "$EXPIRES_SECONDS")
    TOKEN=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n')
    TOKEN_HEX=$(printf '%s' "$TOKEN" | sha256_text)
    INVITATION_ID="invite.$(printf '%.24s' "$TOKEN_HEX")"
    TOKEN_DIGEST="sha256:$TOKEN_HEX"
    APPROVAL_HEX=$(printf '%s\n%s\n%s\n%s' \
      "$INVITATION_ID" "$TOKEN_DIGEST" "$CREATED_AT" "$EXPIRES_AT" | sha256_text)
    APPROVAL_DIGEST="sha256:$APPROVAL_HEX"
    NODE_ID=${TAHTO_NODE_ID:-node.home}
    ENVELOPE=$(printf \
      '{"protocol":"tahto.pairing-invitation/0-alpha","id":"%s","node":"%s","tokenDigest":"%s","approvalDigest":"%s","createdAt":"%s","expiresAt":"%s","createdSeconds":%s,"expiresSeconds":%s,"status":"open"}' \
      "$INVITATION_ID" "$NODE_ID" "$TOKEN_DIGEST" "$APPROVAL_DIGEST" \
      "$CREATED_AT" "$EXPIRES_AT" "$NOW_SECONDS" "$EXPIRES_SECONDS")
    ENCODED=$(printf '%s' "$ENVELOPE" | base64url_text)
    curl --fail --silent --show-error \
      -X POST \
      -H 'accept: application/json' \
      -H "x-tahto-pairing: $ENCODED" \
      "$ORIGIN/tahto/0-alpha/pairing/invitations" >/dev/null
    printf '%s~%s\n' "$INVITATION_ID" "$TOKEN"
    ;;
  open)
    URL="$ORIGIN/"
    if command -v open >/dev/null 2>&1; then
      exec open "$URL"
    elif command -v xdg-open >/dev/null 2>&1; then
      exec xdg-open "$URL"
    else
      printf '%s\n' "$URL"
    fi
    ;;
  help|-h|--help)
    cat <<'EOF'
Tahto · Greenways application-state fabric

Usage:
  tahto run       Run the node control plane in the foreground
  tahto dev       Run the development profile
  tahto check     Validate the Hara/Hoplite project
  tahto build     Build Hoplite and Nginx configuration
  tahto start     Start the Hoplite service
  tahto status    Inspect the Hoplite process
  tahto reload    Reload the service
  tahto stop      Stop the service
  tahto install   Install the macOS LaunchAgent
  tahto uninstall Remove the macOS LaunchAgent
  tahto doctor    Read local health and status
  tahto invite    Mint a short-lived one-time device invitation
  tahto open      Open the local Tahto descriptor

Set HOPLITE to select the Hoplite executable and TAHTO_ORIGIN when operating a
non-default listener.
EOF
    ;;
  *)
    printf 'tahto: unknown command: %s\n' "$ACTION" >&2
    exit 2
    ;;
esac
