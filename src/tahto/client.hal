(ns tahto.client
  (:require [std.foundation :refer :all]
            [tahto.node.request-verification :as request-verification]
            [tahto.protocol.validate :as validate]
            [tahto.semantic.service :as semantic-service]
            [tahto.semantic.value-source :as value-source]
            [tahto.store.model :as model]
            [tahto.store.provider :as provider]
            [tahto.sync.session :as sync]))

(def protocol "tahto.client/0-alpha")
(def request-protocol "tahto.client-request/0-alpha")
(def result-protocol "tahto.client-result/0-alpha")
(def head-result-protocol "tahto.head-read-result/0-alpha")

(def semantic-read-operation "tahto.semantic/read")
(def semantic-prepare-operation "tahto.semantic/prepare")
(def semantic-submit-operation "tahto.semantic/submit")
(def semantic-value-source-operation "tahto.semantic/value-source")
(def head-read-operation "tahto.head/read")
(def sync-plan-operation "tahto.sync/plan")
(def sync-push-operation "tahto.sync/push")
(def sync-pull-operation "tahto.sync/pull")
(def sync-ack-operation "tahto.sync/ack")

(def operations
  [semantic-read-operation semantic-prepare-operation semantic-submit-operation
   semantic-value-source-operation head-read-operation sync-plan-operation
   sync-push-operation sync-pull-operation sync-ack-operation])

(def request-fields
  #{:protocol :operation :coordinate :payload
    :package-revision :provider-revision})

(def coordinate-fields
  #{:application :namespace :collection})

(def semantic-payload-fields
  #{:service-request})

(def value-source-payload-fields
  #{:request})

(def plan-payload-fields
  #{:direction :request})

(defn truth-value
  [value]
  (if value true false))

(defn member?
  [values expected]
  (reduce (fn [found value] (or found (= value expected))) false values))

(defn coordinate?
  [value]
  (truth-value
   (and
    (validate/exact-record? value coordinate-fields #{})
    (model/identifier? (get value :application))
    (model/identifier? (get value :namespace))
    (model/identifier? (get value :collection)))))

(defn request?
  [value]
  (truth-value
   (and
    (validate/exact-record? value request-fields #{})
    (= request-protocol (get value :protocol))
    (member? operations (get value :operation))
    (coordinate? (get value :coordinate))
    (map? (get value :payload))
    (model/canonical-digest? (get value :package-revision))
    (provider/provider-revision? (get value :provider-revision)))))

(defn coordinate-vector
  [value]
  [(get value :application)
   (get value :namespace)
   (get value :collection)])

(defn context-coordinate
  [context]
  [(get context :application)
   (get context :namespace)
   (get context :collection)])

(defn semantic-operation?
  [operation]
  (member?
   [semantic-read-operation semantic-prepare-operation semantic-submit-operation]
   operation))

(defn semantic-route-operation
  [operation]
  (cond
    (= operation semantic-read-operation) "semantic/read"
    (= operation semantic-prepare-operation) "semantic/prepare"
    (= operation semantic-submit-operation) "semantic/submit"
    :else nil))

(defn kernel-operation
  [request]
  (let [operation (get request :operation)
        direction (get-in request [:payload :direction])]
    (cond
      (= operation semantic-read-operation) "semantic.read"
      (= operation semantic-prepare-operation) "semantic.prepare"
      (= operation semantic-submit-operation) "semantic.submit"
      (= operation semantic-value-source-operation) "semantic.read"
      (= operation head-read-operation) "head.read"
      (= operation sync-push-operation) "sync.push"
      (= operation sync-pull-operation) "sync.pull"
      (= operation sync-ack-operation) "sync.ack"
      (and (= operation sync-plan-operation) (= direction "push")) "sync.push"
      (and (= operation sync-plan-operation) (= direction "pull")) "sync.pull"
      :else nil)))

(defn base-context-compatible?
  [context request]
  (truth-value
   (and
    (validate/request-context? context)
    (= "pending" (get context :status))
    (= false (get context :replayed))
    (nil? (get context :result-digest))
    (= (kernel-operation request) (get context :operation))
    (= (coordinate-vector (get request :coordinate))
       (context-coordinate context)))))

(defn semantic-payload?
  [value]
  (truth-value
   (and
    (validate/exact-record? value semantic-payload-fields #{})
    (semantic-service/request? (get value :service-request)))))

(defn value-source-payload?
  [value]
  (truth-value
   (and
    (validate/exact-record? value value-source-payload-fields #{})
    (value-source/request? (get value :request)))))

(defn service-request
  [request]
  (get-in request [:payload :service-request]))

(defn service-verification
  [request]
  (request-verification/verification-value
   (get (service-request request) :wire)))

(defn semantic-context-compatible?
  [context request]
  (let [service-request-value (service-request request)
        verification (service-verification request)
        selected (get service-request-value :route)
        authority (get service-request-value :authority)]
    (truth-value
     (and
      (semantic-payload? (get request :payload))
      (= (semantic-route-operation (get request :operation))
         (get selected :operation))
      (= (coordinate-vector (get request :coordinate))
         [(get selected :application)
          (get selected :namespace)
          (get selected :collection)])
      (= (get request :provider-revision)
         (semantic-service/expected-revision service-request-value))
      (= [(get context :device)
          (get context :operation)
          (get context :application)
          (get context :namespace)
          (get context :collection)
          (get context :request-digest)
          (get context :idempotency-key)
          (get context :authority-root)]
         [(get verification :device)
          (get verification :operation)
          (get verification :application)
          (get verification :namespace)
          (get verification :collection)
          (get verification :request-digest)
          (get verification :idempotency-key)
          (get authority :decision-root)])))))

(defn context-compatible?
  [context request]
  (truth-value
   (and
    (base-context-compatible? context request)
    (if (semantic-operation? (get request :operation))
      (semantic-context-compatible? context request)
      true))))

(defn fail
  ([state code]
   (model/fail state code))
  ([state code details]
   (model/fail state code details)))

(defn result-value
  [request value]
  {:protocol result-protocol
   :operation (get request :operation)
   :coordinate (get request :coordinate)
   :package-revision (get request :package-revision)
   :provider-revision (get request :provider-revision)
   :value value})

(defn wrap
  [request outcome]
  (if (get outcome :ok)
    (model/ok
     (get outcome :state)
     (result-value request (get outcome :value))
     (get outcome :effects))
    outcome))

(defn head-request?
  [value]
  (truth-value
   (and
    (validate/exact-record? value #{:kind :name} #{})
    (member? validate/head-kinds (get value :kind))
    (model/identifier? (get value :name)))))

(defn head-read
  [state context payload]
  (let [application (get context :application)
        namespace-value (get context :namespace)
        collection (get context :collection)
        kind (get payload :kind)
        name (get payload :name)
        head
        (model/head-record
         state application namespace-value collection kind name)
        digest
        (model/head-digest
         state application namespace-value collection kind name)]
    (cond
      (not (head-request? payload))
      (fail state "tahto.head/read-request-invalid")

      (nil? head)
      (fail state "tahto.head/read-head-missing"
            {:kind kind :name name})

      (not (validate/head? head))
      (fail state "tahto.head/read-head-invalid")

      (not (model/canonical-digest? digest))
      (fail state "tahto.head/read-digest-missing")

      :else
      (model/ok
       state
       {:protocol head-result-protocol
        :application application
        :namespace namespace-value
        :collection collection
        :head-digest digest
        :head
        {:kind (get head :kind)
         :name (get head :name)
         :commits (get head :commits)
         :updated-at (get head :updated-at)}}))))

(defn plan-payload?
  [value]
  (truth-value
   (and
    (validate/exact-record? value plan-payload-fields #{})
    (or (= "push" (get value :direction))
        (= "pull" (get value :direction)))
    (map? (get value :request)))))

(defn invoke-with
  [state context request open-source]
  (let [operation (get request :operation)
        payload (get request :payload)]
    (cond
      (semantic-operation? operation)
      (semantic-service/dispatch-verified
       state
       (service-request request)
       (service-verification request))

      (= operation semantic-value-source-operation)
      (if (or (nil? open-source)
              (not (value-source-payload? payload)))
        (fail state "tahto.client/value-source-unavailable")
        (value-source/open-with
         state context (get payload :request) open-source))

      (= operation head-read-operation)
      (head-read state context payload)

      (= operation sync-push-operation)
      (sync/plan-push state context payload)

      (= operation sync-pull-operation)
      (sync/plan-pull state context payload)

      (= operation sync-ack-operation)
      (sync/acknowledge-pull state context payload)

      (= operation sync-plan-operation)
      (if (not (plan-payload? payload))
        (fail state "tahto.client/plan-payload-invalid")
        (if (= "push" (get payload :direction))
          (sync/plan-push state context (get payload :request))
          (sync/plan-pull state context (get payload :request))))

      :else
      (fail state "tahto.client/operation-unsupported"))))

(defn dispatch-with
  [state context installed-package-revision request open-source]
  (cond
    (not (request? request))
    (fail state "tahto.client/request-invalid")

    (not (= installed-package-revision
            (get request :package-revision)))
    (fail state "tahto.client/package-revision-mismatch")

    (not (= (provider/state-revision state)
            (get request :provider-revision)))
    (fail state "tahto.client/provider-revision-mismatch")

    (not (context-compatible? context request))
    (fail state "tahto.client/context-not-admitted")

    :else
    (wrap request (invoke-with state context request open-source))))

(defn dispatch
  [state context installed-package-revision request]
  (dispatch-with state context installed-package-revision request nil))
