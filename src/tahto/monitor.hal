(ns tahto.monitor
  (:require [std.foundation :refer :all]
            [tahto.store.capability :as capability]
            [tahto.store.model :as model]
            [tahto.store.provider :as provider]))

(def protocol "tahto.monitor-probe/0-alpha")
(def diagnostics-protocol "tahto.diagnostics/0-alpha")
(def diagnostics-operation "monitor.diagnostics")

(defn collection-count
  [state key]
  (count (model/value-or state key {})))

(defn state-counts
  [state]
  {:devices (collection-count state :devices)
   :objects (collection-count state :objects)
   :commits (collection-count state :commits)
   :heads (collection-count state :heads)
   :backups (collection-count state :backups)})

(defn inspect-result
  [result]
  (cond
    (not (and (map? result)
              (model/boolean-value? (get result :ok))))
    {:protocol protocol
     :state "degraded"
     :metadata "invalid-result"
     :error "tahto.monitor/probe-result-invalid"}

    (not (get result :ok))
    {:protocol protocol
     :state "degraded"
     :metadata "unavailable"
     :error (get-in result [:error :code])}

    :else
    (let [state (provider/loaded-state (get result :value))]
      (if
       (nil? state)
       {:protocol protocol
        :state "not-ready"
        :metadata "uninitialized"
        :error nil}
       {:protocol protocol
        :state "ready"
        :metadata "ready"
        :error nil
        :revision (provider/state-revision state)
        :counts (state-counts state)}))))

(defn inspect-object-result
  [result]
  (cond
    (not (and (map? result)
              (model/boolean-value? (get result :ok))))
    {:state "degraded"
     :object "invalid-result"
     :object-error "tahto.monitor/object-probe-result-invalid"}

    (not (get result :ok))
    {:state "degraded"
     :object "unavailable"
     :object-error (get-in result [:error :code])}

    :else
    {:state "ready"
     :object "ready"
     :object-error nil}))

(defn inspect-results
  [metadata-result object-result]
  (let [metadata (inspect-result metadata-result)
        object (inspect-object-result object-result)]
    (assoc
     (assoc
      (assoc metadata :object (get object :object))
      :object-error (get object :object-error))
     :state
     (if (= "ready" (get object :state))
       (get metadata :state)
       "degraded"))))

(defn probe-with
  [invoke]
  (inspect-results
   (provider/execute-prepared-with
    (provider/prepare-load (model/empty-state))
    invoke)
   (capability/execute-probe-with (model/empty-state) invoke)))

(defn diagnostics
  [inspection checked-at]
  {:protocol diagnostics-protocol
   :checkedAt checked-at
   :state (get inspection :state)
   :checks
   {:metadata
    {:state (get inspection :metadata)
     :revision (get inspection :revision)
     :error (get inspection :error)}
    :object
    {:state (get inspection :object)
     :error (get inspection :object-error)}}
   :counts (model/value-or inspection :counts {})})

(defn diagnostic-proof?
  [state proof]
  (and
   (map? proof)
   (= diagnostics-operation (get proof :operation))
   (= "greenways.os" (get proof :application))
   (= "tahto.monitor" (get proof :namespace))
   (= "diagnostics" (get proof :collection))
   (model/device-enrolled? state (get proof :device))
   (= (get proof :device)
      (model/public-key-device state (get proof :public-key)))))

(defn diagnose-results
  [metadata-result object-result proof checked-at]
  (let [inspection (inspect-results metadata-result object-result)
        state (provider/loaded-state (get metadata-result :value))]
    (cond
      (not (= "ready" (get inspection :state)))
      (model/fail {} "tahto.monitor/provider-not-ready")

      (not (diagnostic-proof? state proof))
      (model/fail {} "tahto.monitor/device-not-authorized")

      :else
      (model/ok state (diagnostics inspection checked-at)))))

(defn diagnose-result
  [result proof checked-at]
  (diagnose-results
   result
   (model/ok
    {}
    {:protocol capability/result-protocol
     :operation "probe"
     :ready true})
   proof
   checked-at))
