(ns tahto.fixture.durable
  (:require [std.foundation :refer :all]
            [tahto.fixture.ingress :as ingress]
            [tahto.store.model :as model]
            [tahto.store.provider :as provider]
            [tahto.store.transaction :as transaction]))

;; This namespace composes only reviewed pure-HAL boundaries. Hoplite verifies
;; and durably admits the signed request; ingress binds its fingerprint to one
;; Tahto request context; TAHTO-7 completes the deterministic mutation; and the
;; generic hara.store provider persists the exact next state and opaque receipt.

(defn rollback-result
  [state result]
  (model/fail
   state
   (get-in result [:error :code])
   (get-in result [:error :details])))

(defn prepare-mutation
  [state identity accepted-at transition input
   result-verification commit-verification]
  (let [authorized
        (ingress/authorize state identity accepted-at)]
    (if
     (not (get authorized :ok))
     authorized
     (let [authorized-state (get authorized :state)
           context (get authorized :value)]
       (if
        (not (= "pending" (get context :status)))
        (model/fail
         state
         "tahto.fixture/request-not-pending"
         {:status (get context :status)
          :result-digest (get context :result-digest)})
        (let [executed
              (transaction/execute-authorized
               authorized-state
               (transaction/current-revision authorized-state)
               context
               transition
               input
               result-verification)]
          (if
           (not (get executed :ok))
           executed
           (let [prepared
                 (provider/prepare-compare-and-swap
                  executed commit-verification)]
             (if
              (get prepared :ok)
              prepared
              (rollback-result state prepared))))))))))

(defn execute-mutation-with
  [state identity accepted-at transition input
   result-verification commit-verification invoke]
  (let [prepared
        (prepare-mutation
         state identity accepted-at transition input
         result-verification commit-verification)
        executed
        (provider/execute-prepared-with prepared invoke)]
    (if
     (and
      (get prepared :ok)
      (not (get executed :ok)))
     (rollback-result state executed)
     executed)))

(defn prepare-replay
  [state identity accepted-at plan-digest]
  (let [authorized
        (ingress/authorize state identity accepted-at)]
    (if
     (not (get authorized :ok))
     authorized
     (let [context (get authorized :value)]
       (if
        (and
         (= "completed" (get context :status))
         (= true (get context :replayed)))
        (provider/prepare-receipt
         (get authorized :state)
         plan-digest)
        (model/fail
         state
         "tahto.fixture/replay-not-completed"
         {:status (get context :status)
          :replayed (get context :replayed)}))))))

(defn execute-replay-with
  [state identity accepted-at plan-digest invoke]
  (provider/execute-prepared-with
   (prepare-replay
    state identity accepted-at plan-digest)
   invoke))
