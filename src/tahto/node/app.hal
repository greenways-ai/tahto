(ns tahto.node.app
  (:require [hoplite.core :as h]
            [std.foundation.coroutine :as coroutine]
            [std.foundation.host :as foundation-host]
            [std.foundation.json :as json]
            [tahto.node.pairing-service :as pairing-service]
            [tahto.node.pairing-wire :as pairing-wire]
            [tahto.node.request-auth :as request-auth]
            [tahto.monitor :as monitor]
            [tahto.protocol.descriptor :as descriptor]
            [tahto.store.capability :as capability]
            [tahto.store.model :as model]
            [tahto.store.provider :as provider]))

(def public-headers
  {"content-type" "application/json; charset=utf-8"
   "cache-control" "no-store"
   "access-control-allow-origin" "*"
   "access-control-allow-methods" "GET, POST, OPTIONS"
   "access-control-allow-headers"
   "authorization, content-type, x-tahto-pairing, x-tahto-request"
   "x-content-type-options" "nosniff"})

(defn json-response
  [status value]
  {:status status
   :headers public-headers
   :body (json/write value)})

(defn root
  [_request]
  (json-response 200 (descriptor/descriptor)))

(defn ^:async health
  [_request]
  (let [state (model/empty-state)
        metadata-call (get (provider/prepare-load state) :value)
        metadata-native
        (coroutine/await
         (foundation-host/call
          (get metadata-call :service)
          (get metadata-call :operation)
          (provider/call-request metadata-call)))
        metadata-result
        (provider/accept-result state metadata-call metadata-native)
        object-call (capability/host-call (capability/probe-request))
        object-native
        (coroutine/await
         (foundation-host/call
          (get object-call :service)
          (get object-call :operation)
          (capability/call-request object-call)))
        object-result
        (capability/accept-result state object-call object-native)]
    (json-response
     200
     (descriptor/health-with
      (monitor/inspect-results metadata-result object-result)))))

(defn ^:async status
  [_request]
  (let [state (model/empty-state)
        metadata-call (get (provider/prepare-load state) :value)
        metadata-native
        (coroutine/await
         (foundation-host/call
          (get metadata-call :service)
          (get metadata-call :operation)
          (provider/call-request metadata-call)))
        metadata-result
        (provider/accept-result state metadata-call metadata-native)
        object-call (capability/host-call (capability/probe-request))
        object-native
        (coroutine/await
         (foundation-host/call
          (get object-call :service)
          (get object-call :operation)
          (capability/call-request object-call)))
        object-result
        (capability/accept-result state object-call object-native)]
    (json-response
     200
     (descriptor/status-with
      (monitor/inspect-results metadata-result object-result)))))

(defn beacon-compatibility
  [_request]
  (json-response 200 (descriptor/beacon-compatibility)))

(defn monitor-error
  [status code]
  (json-response status {"error" {"code" code}}))

(defn ^:async diagnostics
  [request]
  (let [encoded (get (get request :headers) "x-tahto-request")]
    (if
     (not (string? encoded))
     (monitor-error 401 "tahto.monitor/request-missing")
     (let [wire (request-auth/decode-envelope encoded)
           now-seconds (request-auth/host-call "now" [])
           proof (request-auth/verify wire now-seconds)]
       (if
        (nil? proof)
        (monitor-error 403 "tahto.monitor/signature-invalid")
        (let [state (model/empty-state)
              metadata-call (get (provider/prepare-load state) :value)
              metadata-native
              (coroutine/await
               (foundation-host/call
                (get metadata-call :service)
                (get metadata-call :operation)
                (provider/call-request metadata-call)))
              metadata-result
              (provider/accept-result state metadata-call metadata-native)
              object-call
              (capability/host-call (capability/probe-request))
              object-native
              (coroutine/await
               (foundation-host/call
                (get object-call :service)
                (get object-call :operation)
                (capability/call-request object-call)))
              object-result
              (capability/accept-result state object-call object-native)
              result
              (monitor/diagnose-results
               metadata-result object-result proof (get wire "timestamp"))]
          (if
           (get result :ok)
           (json-response 200 (get result :value))
           (let [code (get-in result [:error :code])]
             (monitor-error
              (if (= code "tahto.monitor/device-not-authorized") 403 503)
              code)))))))))

(defn preflight
  [_request]
  {:status 204
   :headers public-headers
   :body ""})

(defn pairing-header
  [request]
  (get (get request :headers) "x-tahto-pairing"))

(defn pairing-error
  [status result]
  (json-response status (pairing-wire/error-result result)))

(defn loopback-request?
  [request]
  (has? #{"127.0.0.1" "::1"} (get request :remote-address)))

(defn ^:async pairing-issue
  [request]
  (if
   (not (loopback-request? request))
   (json-response
    403 {"error" {"code" "tahto.pairing/management-local-only"}})
   (let [encoded (pairing-header request)]
     (if
      (not (string? encoded))
      (json-response
       400 {"error" {"code" "tahto.pairing/envelope-missing"}})
      (let [wire (request-auth/decode-envelope encoded)
            input (pairing-wire/issue-request wire)]
        (if
         (nil? input)
         (json-response
          400 {"error" {"code" "tahto.pairing/invitation-invalid"}})
         (let [result
               (coroutine/await
                (pairing-service/execute
                 "pairing.issue" input (get input :created-at)))]
           (if
            (get result :ok)
            (json-response
             201 (pairing-wire/issue-result (get result :value)))
            (pairing-error 409 result)))))))))

(defn ^:async pairing-prepare
  [request]
  (let [encoded (pairing-header request)]
    (if
     (not (string? encoded))
     (json-response
      400 {"error" {"code" "tahto.pairing/envelope-missing"}})
     (let [wire (request-auth/decode-envelope encoded)
           now-seconds
           (request-auth/host-call "now" [])
           input (pairing-wire/prepare-request wire now-seconds)]
       (if
        (nil? input)
        (json-response
         400 {"error" {"code" "tahto.pairing/prepare-invalid"}})
        (let [result
              (coroutine/await
               (pairing-service/execute
                "pairing.prepare" input (get input :prepared-at)))]
          (if
           (get result :ok)
           (json-response
            200 (pairing-wire/prepare-result (get result :value)))
           (pairing-error 409 result))))))))

(defn ^:async pairing-complete
  [request]
  (let [encoded (pairing-header request)]
    (if
     (not (string? encoded))
     (json-response
      400 {"error" {"code" "tahto.pairing/envelope-missing"}})
     (let [wire (request-auth/decode-envelope encoded)
           now-seconds
           (request-auth/host-call "now" [])
           input (pairing-wire/complete-request wire now-seconds)]
       (if
        (nil? input)
        (json-response
         403 {"error" {"code" "tahto.pairing/signature-invalid"}})
        (let [result
              (coroutine/await
               (pairing-service/execute
                "pairing.complete" input (get input :accepted-at)))]
          (if
           (get result :ok)
           (json-response
            200 (pairing-wire/complete-result (get result :value)))
           (pairing-error 409 result))))))))

(def app
  (h/app
    {:name "tahto"
     :resources
     [["/"
       {:get {:name :tahto/root
              :summary "Describe this Tahto node"
              :handler #'root}
        :options {:name :tahto/root-options
                  :handler #'preflight}}]
      ["/.well-known/tahto"
       {:get {:name :tahto/discovery
              :summary "Discover the local Tahto node"
              :handler #'root}
        :options {:name :tahto/discovery-options
                  :handler #'preflight}}]
      ["/tahto/0-alpha/health"
       {:get {:name :tahto/health
              :summary "Report Tahto control-plane readiness"
              :handler #'health}
        :options {:name :tahto/health-options
                  :handler #'preflight}}]
      ["/tahto/0-alpha/status"
       {:get {:name :tahto/status
              :summary "Report installed Tahto fabric components"
              :handler #'status}
        :options {:name :tahto/status-options
                  :handler #'preflight}}]
      ["/tahto/0-alpha/diagnostics"
       {:post {:name :tahto/diagnostics
               :summary "Report bounded diagnostics to one paired device"
               :handler #'diagnostics}
        :options {:name :tahto/diagnostics-options
                  :handler #'preflight}}]
      ["/tahto/0-alpha/pairing/prepare"
       {:post {:name :tahto.pairing/prepare
               :summary "Bind an invitation to one browser device key"
               :handler #'pairing-prepare}
        :options {:name :tahto.pairing/prepare-options
                  :handler #'preflight}}]
      ["/tahto/0-alpha/pairing/invitations"
       {:post {:name :tahto.pairing/issue
               :summary "Mint one loopback-managed pairing invitation"
               :handler #'pairing-issue}
        :options {:name :tahto.pairing/issue-options
                  :handler #'preflight}}]
      ["/tahto/0-alpha/pairing/complete"
       {:post {:name :tahto.pairing/complete
               :summary "Verify and atomically enrol one paired device"
               :handler #'pairing-complete}
        :options {:name :tahto.pairing/complete-options
                  :handler #'preflight}}]
      ["/.well-known/greenways-beacon"
       {:get {:name :tahto.compat/beacon-discovery
              :summary "Describe the Beacon to Tahto compatibility route"
              :handler #'beacon-compatibility}
        :options {:name :tahto.compat/beacon-discovery-options
                  :handler #'preflight}}]
      ["/beacon/v1/health"
       {:get {:name :tahto.compat/beacon-health
              :summary "Compatibility alias for Tahto health"
              :handler #'health}
        :options {:name :tahto.compat/beacon-health-options
                  :handler #'preflight}}]
      ["/beacon/v1/status"
       {:get {:name :tahto.compat/beacon-status
              :summary "Compatibility alias for Tahto status"
              :handler #'status}
        :options {:name :tahto.compat/beacon-status-options
                  :handler #'preflight}}]]}))
