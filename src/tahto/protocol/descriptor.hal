(ns tahto.protocol.descriptor)

(def protocol "tahto.node/1")
(def health-protocol "tahto.health/1")
(def status-protocol "tahto.status/1")

(defn descriptor
  []
  {"protocol" protocol
   "id" "greenways.tahto"
   "name" "Tahto"
   "role" "application-state-fabric"
   "runtime"
   {"applicationServer" "Hoplite"
    "language" "Hara"
    "namespace" "tahto.node.app"
    "edge" "Nginx"}
   "authority"
   {"installation" "greenways-os"
    "consent" "greenways-os"
    "privateKeys" "greenways-os"
    "custody" "tahto"
    "meaning" "application-and-specification-packages"}
   "boundaries"
   {"conflicts" "preserve-divergent-heads"
    "remoteExecutableCatalogue" false
    "hostedSpaceRequired" false
    "largeObjectBodies" "request-work-scoped-host-sources"
    "signedRecords" "verified-provider-proofs"
    "devicePairing" "identity-only-no-admin-grant"
    "requestReplay" "durable-nonce-and-idempotency-evidence"
    "metadataTransactions" "deterministic-plan-provider-cas"
    "metadataHost" "generic-installed-hara-store-no-request-selection"
    "objectHost" "generic-installed-hara-blob-no-request-selection"
    "serviceDescriptors" "inert-digest-pinned-metadata"
    "workerExecution" "application-owned-installed-provider"
    "semanticSchemas" "exact-installed-package-roots"}
   "routes"
   {"discovery" "/.well-known/tahto"
    "health" "/tahto/v1/health"
    "status" "/tahto/v1/status"}
   "components"
   {"controlPlane" "ready"
    "objects" "hara-kernel-ready:TAHTO-3"
    "objectCapabilityClient" "ready:hara.blob-request/1"
    "objectProviders" "hoplite-memory-and-filesystem-ready"
    "uploadOrchestration" "hara-kernel-ready"
    "responseSourceProjection" "hara-kernel-ready"
    "responseSourceTransport" "hoplite-request-scoped-nginx-ready"
    "commitsHeadsBackups" "hara-kernel-ready:TAHTO-4"
    "deviceIdentityReplay" "hara-kernel-ready:TAHTO-5"
    "deviceSyncPlanning" "hara-kernel-ready:TAHTO-5"
    "portableTwoDeviceLaw" "hara-conformance-ready"
    "productionTwoDeviceFixture" "pending"
    "servicesAndJobs" "hara-kernel-ready:TAHTO-6"
    "atomicMetadataPlan" "hara-kernel-ready:TAHTO-7"
    "metadataCapabilityClient" "ready:hara.store-request/1"
    "sqliteMetadataProvider" "hoplite-generic-provider-ready"
    "metadataNodeService" "not-exposed"
    "semanticFabric" "planned:T-SF-01"
    "signatureProvider" "not-wired"
    "resultVerificationProvider" "not-wired"
    "serviceExecutor" "not-wired"}
   "compatibility"
   {"greenwaysBeacon" "one-release-route-alias"}})

(defn health
  []
  {"protocol" health-protocol
   "status" "ready"
   "runtime" "hoplite"
   "scope" "control-plane-and-generic-capability-kernels"})

(defn status
  []
  {"protocol" status-protocol
   "node"
   {"status" "ready"
    "phase" "generic-capability-baseline"
    "mode" "local"}
   "fabric"
   {"objectVault" "hara-kernel-ready"
    "commitStore" "hara-kernel-ready"
    "headStore" "hara-kernel-ready"
    "backupStore" "hara-kernel-ready"
    "deviceIdentity" "hara-kernel-ready"
    "requestReplay" "hara-kernel-ready"
    "syncPlanning" "hara-kernel-ready"
    "serviceRegistry" "hara-kernel-ready"
    "jobLedger" "hara-kernel-ready"
    "atomicMetadataPlan" "hara-kernel-ready"
    "metadataCapability" "hara.store-client-ready"
    "metadataProvider" "hoplite-sqlite-ready"
    "metadataNodeService" "not-exposed"
    "objectCapability" "hara.blob-client-ready"
    "objectUpload" "filesystem-provider-ready"
    "objectResponseSource" "request-scoped-transport-ready"
    "portableTwoDeviceLaw" "ready"
    "productionTwoDeviceFixture" "pending"
    "semanticFabric" "planned"
    "signatureProvider" "not-wired"
    "resultVerificationProvider" "not-wired"
    "workerExecution" "not-wired"}
   "hostedSpace"
   {"required" false
    "adapter" "optional"}})

(defn beacon-compatibility
  []
  {"protocol" "greenways-beacon/1"
   "status" "compatibility-only"
   "canonical" "/.well-known/tahto"
   "replacement" (descriptor)})
