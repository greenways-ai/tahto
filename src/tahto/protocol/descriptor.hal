(ns tahto.protocol.descriptor)

(def protocol "tahto.node/0-alpha")
(def health-protocol "tahto.health/0-alpha")
(def status-protocol "tahto.status/0-alpha")

(defn descriptor
  []
  {"protocol" protocol
   "id" "greenways.tahto"
   "name" "Tahto"
   "role" "application-state-fabric"
   "runtime"
   {"applicationServer" "Hoplite"
    "language" "Hara"
    "namespace" "tahto.node.app"
    "edge" "Nginx"}
   "authority"
   {"installation" "greenways-os"
    "consent" "greenways-os"
    "privateKeys" "greenways-os"
    "custody" "tahto"
    "meaning" "application-and-specification-packages"}
   "boundaries"
   {"conflicts" "preserve-divergent-heads"
    "remoteExecutableCatalogue" false
    "hostedSpaceRequired" false
    "largeObjectBodies" "request-work-scoped-host-sources"
    "signedRecords" "verified-provider-proofs"
    "devicePairing" "identity-only-no-admin-grant"
    "requestReplay" "durable-nonce-and-idempotency-evidence"
    "metadataTransactions" "deterministic-plan-provider-cas"
    "metadataHost" "generic-installed-hara-store-no-request-selection"
    "objectHost" "generic-installed-hara-blob-no-request-selection"
    "serviceDescriptors" "inert-digest-pinned-metadata"
    "workerExecution" "application-owned-installed-provider"
    "semanticSchemas" "exact-installed-package-roots"}
   "routes"
   {"discovery" "/.well-known/tahto"
    "health" "/tahto/0-alpha/health"
    "status" "/tahto/0-alpha/status"
    "diagnostics" "/tahto/0-alpha/diagnostics"
    "pairingPrepare" "/tahto/0-alpha/pairing/prepare"
    "pairingComplete" "/tahto/0-alpha/pairing/complete"}
   "components"
   {"controlPlane" "ready"
    "objects" "hara-kernel-ready:TAHTO-3"
    "objectCapabilityClient" "ready:hoplite.blob-request/0-alpha"
    "objectProviders" "configured:not-probed"
    "uploadOrchestration" "hara-kernel-ready"
    "responseSourceProjection" "hara-kernel-ready"
    "responseSourceTransport" "hoplite-request-scoped-nginx-ready"
    "commitsHeadsBackups" "hara-kernel-ready:TAHTO-4"
    "deviceIdentityReplay" "hara-kernel-ready:TAHTO-5"
    "deviceSyncPlanning" "hara-kernel-ready:TAHTO-5"
    "devicePairing" "hara-kernel-and-greenways-client-ready"
    "portableTwoDeviceLaw" "hara-conformance-ready"
    "productionTwoDeviceFixture" "pending"
    "servicesAndJobs" "hara-kernel-ready:TAHTO-6"
    "atomicMetadataPlan" "hara-kernel-ready:TAHTO-7"
    "metadataCapabilityClient" "ready:hoplite.store-request/0-alpha"
    "sqliteMetadataProvider" "hoplite-generic-provider-ready"
    "metadataNodeService" "not-exposed"
    "semanticFabric" "kernel-ready:service-pending"
    "semanticProfiles" "hara-kernel-ready"
    "semanticAdmission" "hara-kernel-ready"
    "semanticIndexesRoots" "hara-kernel-ready"
    "semanticHistory" "hara-kernel-ready"
    "semanticRead" "hara-kernel-ready"
    "semanticPrepare" "hara-kernel-ready"
    "semanticSubmit" "hara-kernel-ready"
    "semanticClientFacade" "portable-hara-ready"
    "semanticChangeFeed" "portable-bounded-ready"
    "semanticRoutes" "not-exposed"
    "semanticAuthenticationRealm" "not-installed"
    "semanticSelectedValueSource" "not-installed"
    "canonicalValueContract" "ready:hoplite.value"
    "canonicalValueProvider" "not-installed"
    "specificationValidatorInvocation" "not-installed"
    "signatureProvider" "pairing-p256-ready"
    "resultVerificationProvider" "contract-ready:filesystem-provider-pending"
    "serviceExecutor" "not-wired"}
   "compatibility"
   {"greenwaysBeacon" "one-release-route-alias"}})

(defn health
  []
  {"protocol" health-protocol
   "status" "ready"
   "runtime" "hoplite"
   "scope" "control-plane-generic-capabilities-and-semantic-kernels"})

(defn status
  []
  {"protocol" status-protocol
   "node"
   {"status" "ready"
    "phase" "semantic-kernel-production-integration"
    "mode" "local"}
   "fabric"
   {"objectVault" "hara-kernel-ready"
    "commitStore" "hara-kernel-ready"
    "headStore" "hara-kernel-ready"
    "backupStore" "hara-kernel-ready"
    "deviceIdentity" "hara-kernel-ready"
    "devicePairing" "ready"
    "requestReplay" "hara-kernel-ready"
    "syncPlanning" "hara-kernel-ready"
    "serviceRegistry" "hara-kernel-ready"
    "jobLedger" "hara-kernel-ready"
    "atomicMetadataPlan" "hara-kernel-ready"
    "metadataCapability" "hoplite.store-client-ready"
    "metadataProvider" "hoplite-sqlite-ready"
    "metadataNodeService" "not-exposed"
    "objectCapability" "hoplite.blob-client-ready"
    "objectUpload" "not-probed"
    "objectResponseSource" "request-scoped-transport-ready"
    "portableTwoDeviceLaw" "ready"
    "productionTwoDeviceFixture" "pending"
    "semanticFabric" "kernel-ready:service-pending"
    "semanticProfiles" "ready"
    "semanticAdmission" "ready"
    "semanticIndexesRoots" "ready"
    "semanticHistory" "ready"
    "semanticRead" "ready"
    "semanticPrepare" "ready"
    "semanticSubmit" "ready"
    "semanticClientFacade" "ready"
    "semanticChangeFeed" "ready"
    "semanticRoutes" "not-exposed"
    "semanticAuthenticationRealm" "not-installed"
    "semanticSelectedValueSource" "not-installed"
    "canonicalValueContract" "ready"
    "canonicalValueProvider" "not-installed"
    "specificationValidatorInvocation" "not-installed"
    "signatureProvider" "pairing-p256-ready"
    "resultVerificationProvider" "provider-pending"
    "workerExecution" "not-wired"}
   "hostedSpace"
   {"required" false
    "adapter" "optional"}})

(defn health-with
  [inspection]
  (assoc
   (assoc
    (assoc
     (health)
     "status" (get inspection :state))
    "metadata" (get inspection :metadata))
   "objects" (get inspection :object)))

(defn status-with
  [inspection]
  (assoc-in
   (assoc-in
    (assoc-in
     (status)
     ["node" "status"] (get inspection :state))
    ["fabric" "metadataProvider"] (get inspection :metadata))
   ["fabric" "objectUpload"] (get inspection :object)))

(defn beacon-compatibility
  []
  {"protocol" "greenways-beacon/0-alpha"
   "status" "compatibility-only"
   "canonical" "/.well-known/tahto"
   "replacement" (descriptor)})
