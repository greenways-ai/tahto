(ns tahto.protocol.records
  (:config {}))

(def signature-profile "tahto-signature/0-alpha")
(def canonical-json-profile "tahto-canonical-json/0-alpha")

(def core-protocols
  #{"tahto.node/0-alpha"
    "tahto.device/0-alpha"
    "tahto.application/0-alpha"
    "tahto.namespace/0-alpha"
    "tahto.collection/0-alpha"
    "tahto.object/0-alpha"
    "tahto.commit/0-alpha"
    "tahto.head/0-alpha"
    "tahto.backup/0-alpha"
    "tahto.receipt/0-alpha"
    "tahto.service/0-alpha"
    "tahto.job/0-alpha"})

(def collection-modes
  #{"snapshot/1"
    "event-log/1"
    "object-graph/1"
    "git-dag/1"
    "derived/1"})

(def collection-authorities
  #{"source"
    "rebuildable"})

(def service-operations
  #{"read"
    "write"
    "sync"
    "backup"
    "restore"
    "service"
    "job"})

(def job-states
  #{"queued"
    "running"
    "blocked"
    "completed"
    "failed"
    "cancelled"})

(defn core-protocol?
  [value]
  (has? core-protocols value))

(defn collection-mode?
  [value]
  (has? collection-modes value))

(defn collection-authority?
  [value]
  (has? collection-authorities value))

(defn service-operation?
  [value]
  (has? service-operations value))

(defn job-state?
  [value]
  (has? job-states value))
