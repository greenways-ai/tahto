(ns tahto.store.provider
  (:require [std.foundation :refer :all]
            [std.foundation.coroutine :as coroutine]
            [std.foundation.host :as foundation-host]
            [tahto.protocol.validate :as validate]
            [tahto.store.model :as model]
            [tahto.store.transaction :as transaction]))

;; Tahto owns snapshot, transaction, receipt and recovery semantics. The host
;; service supplies application-neutral durable value storage and exact
;; revision compare-and-swap only. A native ABI or driver identity never enters
;; the HAL call plan.
(def host-service "hoplite.store")
(def request-protocol "hoplite.store-request/0-alpha")
(def result-protocol "hoplite.store-result/0-alpha")

(def snapshot-protocol "tahto.metadata-snapshot/0-alpha")
(def state-verification-protocol
  "tahto.state-encoding-verification/0-alpha")
(def commit-verification-protocol
  "tahto.metadata-commit-verification/0-alpha")
(def receipt-payload-protocol
  "tahto.metadata-receipt-payload/0-alpha")
(def receipt-protocol "tahto.metadata-commit-receipt/0-alpha")
(def mutation-protocol "tahto.metadata-mutation/0-alpha")

(def max-provider-revision 9223372036854775807)

(def provider-operations
  #{"load" "initialize" "compare-and-swap" "receipt"})

(def receipt-statuses
  #{"applied" "replayed"})

(defn provider-revision?
  [value]
  (and (model/non-negative-integer? value)
       (<= value max-provider-revision)))

(defn state-revision
  [state]
  (model/value-or state :metadata-revision 0))

(defn state-revision-valid?
  [state revision]
  (and (map? state)
       (provider-revision? revision)
       (= revision (state-revision state))))

(def snapshot-fields
  #{:protocol :revision :state :state-digest})

(defn snapshot?
  [value]
  (and
   (validate/exact-record? value snapshot-fields #{})
   (= snapshot-protocol (get value :protocol))
   (state-revision-valid? (get value :state)
                          (get value :revision))
   (model/canonical-digest? (get value :state-digest))))

(def state-verification-fields
  #{:protocol :verified :revision :state-digest :encoded-at})

(defn state-verification?
  [value state]
  (and
   (validate/exact-record? value state-verification-fields #{})
   (= state-verification-protocol (get value :protocol))
   (= true (get value :verified))
   (state-revision-valid? state (get value :revision))
   (model/canonical-digest? (get value :state-digest))
   (validate/timestamp? (get value :encoded-at))))

(def transaction-plan-fields
  #{:protocol :expected-revision :revision :request-digest
    :result-digest :context :result :replayed})

(def mutation-plan-fields
  #{:protocol :expected-revision :revision :request-digest
    :result-digest :operation :result})

(defn transaction-plan
  [transition-result]
  (if (and (map? transition-result)
           (model/boolean-value? (get transition-result :ok)))
    (if (get transition-result :ok)
      (get transition-result :value)
      (get transition-result :transaction))
    nil))

(defn transaction-plan?
  [value state]
  (and
   (validate/exact-record? value transaction-plan-fields #{})
   (= transaction/transaction-protocol (get value :protocol))
   (provider-revision? (get value :expected-revision))
   (provider-revision? (get value :revision))
   (< (get value :expected-revision) max-provider-revision)
   (= (inc (get value :expected-revision))
      (get value :revision))
   (state-revision-valid? state (get value :revision))
   (model/canonical-digest? (get value :request-digest))
   (model/canonical-digest? (get value :result-digest))
   (validate/device-request-context? (get value :context))
   (= "completed" (get-in value [:context :status]))
   (= (get value :request-digest)
      (get-in value [:context :request-digest]))
   (= (get value :result-digest)
      (get-in value [:context :result-digest]))
   (model/boolean-value? (get value :replayed))))

(defn mutation-plan?
  [value state]
  (and
   (validate/exact-record? value mutation-plan-fields #{})
   (= mutation-protocol (get value :protocol))
   (provider-revision? (get value :expected-revision))
   (provider-revision? (get value :revision))
   (< (get value :expected-revision) max-provider-revision)
   (= (inc (get value :expected-revision))
      (get value :revision))
   (state-revision-valid? state (get value :revision))
   (model/canonical-digest? (get value :request-digest))
   (model/canonical-digest? (get value :result-digest))
   (model/identifier? (get value :operation))))

(defn commit-plan?
  [value state]
  (or (transaction-plan? value state)
      (mutation-plan? value state)))

(def commit-verification-fields
  #{:protocol :verified :expected-revision :revision
    :plan-digest :request-digest :result-digest
    :state-digest :completed-at})

(defn commit-verification?
  [value]
  (and
   (validate/exact-record? value commit-verification-fields #{})
   (= commit-verification-protocol (get value :protocol))
   (= true (get value :verified))
   (provider-revision? (get value :expected-revision))
   (provider-revision? (get value :revision))
   (< (get value :expected-revision) max-provider-revision)
   (= (inc (get value :expected-revision))
      (get value :revision))
   (model/canonical-digest? (get value :plan-digest))
   (model/canonical-digest? (get value :request-digest))
   (model/canonical-digest? (get value :result-digest))
   (model/canonical-digest? (get value :state-digest))
   (validate/timestamp? (get value :completed-at))))

(defn commit-verification-matches?
  [verification plan state]
  (and
   (commit-verification? verification)
   (commit-plan? plan state)
   (= (get plan :expected-revision)
      (get verification :expected-revision))
   (= (get plan :revision)
      (get verification :revision))
   (= (get plan :request-digest)
      (get verification :request-digest))
   (= (get plan :result-digest)
      (get verification :result-digest))))

;; The generic store persists this record as an opaque canonical value. It does
;; not interpret Tahto evidence or assign replay meaning. HAL adds the final
;; receipt status after the generic store reports `applied` or `replayed`.
(def receipt-payload-fields
  #{:protocol :revision :plan-digest :request-digest
    :result-digest :state-digest :completed-at})

(defn receipt-payload
  [plan verification]
  {:protocol receipt-payload-protocol
   :revision (get verification :revision)
   :plan-digest (get verification :plan-digest)
   :request-digest (get plan :request-digest)
   :result-digest (get plan :result-digest)
   :state-digest (get verification :state-digest)
   :completed-at (get verification :completed-at)})

(defn receipt-payload?
  [value]
  (and
   (validate/exact-record? value receipt-payload-fields #{})
   (= receipt-payload-protocol (get value :protocol))
   (provider-revision? (get value :revision))
   (> (get value :revision) 0)
   (model/canonical-digest? (get value :plan-digest))
   (model/canonical-digest? (get value :request-digest))
   (model/canonical-digest? (get value :result-digest))
   (model/canonical-digest? (get value :state-digest))
   (validate/timestamp? (get value :completed-at))))

(defn receipt-payload-matches?
  [payload plan verification]
  (and
   (receipt-payload? payload)
   (commit-verification-matches? verification plan
                                  {:metadata-revision
                                   (get verification :revision)})
   (= (get payload :revision)
      (get verification :revision))
   (= (get payload :plan-digest)
      (get verification :plan-digest))
   (= (get payload :request-digest)
      (get plan :request-digest))
   (= (get payload :result-digest)
      (get plan :result-digest))
   (= (get payload :state-digest)
      (get verification :state-digest))
   (= (get payload :completed-at)
      (get verification :completed-at))))

(def receipt-fields
  #{:protocol :status :revision :plan-digest
    :request-digest :result-digest :state-digest :completed-at})

(defn receipt?
  [value]
  (and
   (validate/exact-record? value receipt-fields #{})
   (= receipt-protocol (get value :protocol))
   (has? receipt-statuses (get value :status))
   (provider-revision? (get value :revision))
   (> (get value :revision) 0)
   (model/canonical-digest? (get value :plan-digest))
   (model/canonical-digest? (get value :request-digest))
   (model/canonical-digest? (get value :result-digest))
   (model/canonical-digest? (get value :state-digest))
   (validate/timestamp? (get value :completed-at))))

(defn receipt-matches?
  [receipt verification]
  (and
   (receipt? receipt)
   (commit-verification? verification)
   (= (get receipt :revision)
      (get verification :revision))
   (= (get receipt :plan-digest)
      (get verification :plan-digest))
   (= (get receipt :request-digest)
      (get verification :request-digest))
   (= (get receipt :result-digest)
      (get verification :result-digest))
   (= (get receipt :state-digest)
      (get verification :state-digest))
   (= (get receipt :completed-at)
      (get verification :completed-at))))

(defn load-request
  []
  {:protocol request-protocol
   :operation "load"})

(defn receipt-request
  [plan-digest]
  (if (model/canonical-digest? plan-digest)
    {:protocol request-protocol
     :operation "receipt"
     :receipt-key plan-digest}
    nil))

(defn initialize-request
  [state verification]
  {:protocol request-protocol
   :operation "initialize"
   :revision (get verification :revision)
   :value state
   :value-digest (get verification :state-digest)})

(defn compare-and-swap-request
  [state plan verification]
  {:protocol request-protocol
   :operation "compare-and-swap"
   :expected-revision (get plan :expected-revision)
   :revision (get plan :revision)
   :value state
   :value-digest (get verification :state-digest)
   :receipt-key (get verification :plan-digest)
   :receipt (receipt-payload plan verification)})

(defn provider-request?
  [request]
  (and
   (map? request)
   (= request-protocol (get request :protocol))
   (has? provider-operations (get request :operation))
   (cond
     (= "load" (get request :operation))
     (validate/exact-record? request
                             #{:protocol :operation}
                             #{})

     (= "receipt" (get request :operation))
     (and
      (validate/exact-record? request
                              #{:protocol :operation :receipt-key}
                              #{})
      (model/canonical-digest? (get request :receipt-key)))

     (= "initialize" (get request :operation))
     (and
      (validate/exact-record? request
                              #{:protocol :operation :revision
                                :value :value-digest}
                              #{})
      (state-revision-valid? (get request :value)
                             (get request :revision))
      (model/canonical-digest? (get request :value-digest)))

     (= "compare-and-swap" (get request :operation))
     (let [payload (get request :receipt)]
       (and
        (validate/exact-record?
         request
         #{:protocol :operation :expected-revision :revision
           :value :value-digest :receipt-key :receipt}
         #{})
        (provider-revision? (get request :expected-revision))
        (provider-revision? (get request :revision))
        (< (get request :expected-revision) max-provider-revision)
        (= (inc (get request :expected-revision))
           (get request :revision))
        (state-revision-valid? (get request :value)
                               (get request :revision))
        (model/canonical-digest? (get request :value-digest))
        (model/canonical-digest? (get request :receipt-key))
        (receipt-payload? payload)
        (= (get request :receipt-key)
           (get payload :plan-digest))
        (= (get request :revision)
           (get payload :revision))
        (= (get request :value-digest)
           (get payload :state-digest))))

     :else false)))

(def host-call-fields
  #{:service :operation :arguments})

(defn host-call
  [request]
  {:service host-service
   :operation (get request :operation)
   :arguments [request]})

(defn call-request
  [call]
  (get-in call [:arguments 0]))

(defn host-call?
  [value]
  (let [arguments (get value :arguments)
        request (call-request value)]
    (and
     (validate/exact-record? value host-call-fields #{})
     (= host-service (get value :service))
     (vector? arguments)
     (= 1 (count arguments))
     (provider-request? request)
     (= (get value :operation)
        (get request :operation)))))

(defn request-result
  [state request]
  (model/ok state (host-call request)))

(defn prepare-load
  [state]
  (request-result state (load-request)))

(defn prepare-receipt
  [state plan-digest]
  (let [request (receipt-request plan-digest)]
    (if (nil? request)
      (model/fail state "tahto.provider/plan-digest-invalid")
      (request-result state request))))

(defn prepare-initialize
  [state verification]
  (if (state-verification? verification state)
    (request-result state
                    (initialize-request state verification))
    (model/fail state
                "tahto.provider/state-verification-invalid")))

(defn prepare-compare-and-swap
  [transition-result verification]
  (let [state (get transition-result :state)
        plan (transaction-plan transition-result)]
    (cond
      (not (map? state))
      (model/fail {} "tahto.provider/transition-state-invalid")

      (not (commit-plan? plan state))
      (model/fail state "tahto.provider/transaction-plan-invalid")

      (not (commit-verification-matches?
            verification plan state))
      (model/fail state "tahto.provider/commit-verification-invalid")

      :else
      (request-result
       state
       (compare-and-swap-request state plan verification)))))

(def store-snapshot-result-fields
  #{:protocol :operation :revision :value :value-digest})

(def store-receipt-result-fields
  #{:protocol :operation :status :revision :receipt-key :receipt})

(defn store-snapshot-result?
  [operation value]
  (and
   (has? #{"load" "initialize"} operation)
   (validate/exact-record? value store-snapshot-result-fields #{})
   (= result-protocol (get value :protocol))
   (= operation (get value :operation))
   (state-revision-valid? (get value :value)
                          (get value :revision))
   (model/canonical-digest? (get value :value-digest))))

(defn store-receipt-result?
  [operation value]
  (let [payload (get value :receipt)]
    (and
     (has? #{"compare-and-swap" "receipt"} operation)
     (validate/exact-record? value store-receipt-result-fields #{})
     (= result-protocol (get value :protocol))
     (= operation (get value :operation))
     (has? receipt-statuses (get value :status))
     (or (= operation "compare-and-swap")
         (= "replayed" (get value :status)))
     (provider-revision? (get value :revision))
     (> (get value :revision) 0)
     (model/canonical-digest? (get value :receipt-key))
     (receipt-payload? payload)
     (= (get value :receipt-key)
        (get payload :plan-digest))
     (= (get value :revision)
        (get payload :revision)))))

(defn provider-response?
  [operation value]
  (and
   (has? provider-operations operation)
   (cond
     (= operation "load")
     (or (nil? value)
         (store-snapshot-result? operation value))

     (= operation "initialize")
     (store-snapshot-result? operation value)

     (= operation "compare-and-swap")
     (store-receipt-result? operation value)

     (= operation "receipt")
     (or (nil? value)
         (store-receipt-result? operation value))

     :else false)))

(defn host-result?
  [call value]
  (and (host-call? call)
       (provider-response? (get call :operation) value)))

(defn accept-result
  [state call result]
  (cond
    (not (host-call? call))
    (model/fail state "tahto.provider/call-invalid")

    (not (host-result? call result))
    (model/fail state
                "tahto.provider/result-invalid"
                {:operation (get call :operation)})

    :else
    (model/ok state result)))

(defn execute-call-with
  [state call invoke]
  (if
   (host-call? call)
   (accept-result
    state
    call
    (invoke
     (get call :service)
     (get call :operation)
     (call-request call)))
   (model/fail state "tahto.provider/call-invalid")))

(defn execute-prepared-with
  [prepared invoke]
  (if
   (and (map? prepared)
        (model/boolean-value? (get prepared :ok)))
   (if
    (get prepared :ok)
    (execute-call-with
     (get prepared :state)
     (get prepared :value)
     invoke)
    prepared)
   (model/fail {} "tahto.provider/prepared-invalid")))

(defn ^:async execute-prepared
  [prepared]
  (if
   (and (map? prepared)
        (model/boolean-value? (get prepared :ok)))
   (if
    (get prepared :ok)
    (let [state (get prepared :state)
          call (get prepared :value)
          result
          (coroutine/await
           (foundation-host/call
            (get call :service)
            (get call :operation)
            (call-request call)))]
      (accept-result state call result))
    prepared)
   (model/fail {} "tahto.provider/prepared-invalid")))

(defn snapshot-from-store-result
  [value]
  (if
   (and (map? value)
        (has? #{"load" "initialize"} (get value :operation))
        (store-snapshot-result? (get value :operation) value))
   {:protocol snapshot-protocol
    :revision (get value :revision)
    :state (get value :value)
    :state-digest (get value :value-digest)}
   nil))

(defn receipt-from-store-result
  [value]
  (if
   (and (map? value)
        (has? #{"compare-and-swap" "receipt"}
              (get value :operation))
        (store-receipt-result? (get value :operation) value))
   (let [payload (get value :receipt)]
     {:protocol receipt-protocol
      :status (get value :status)
      :revision (get payload :revision)
      :plan-digest (get payload :plan-digest)
      :request-digest (get payload :request-digest)
      :result-digest (get payload :result-digest)
      :state-digest (get payload :state-digest)
      :completed-at (get payload :completed-at)})
   nil))

(defn initialize-result?
  [state verification store-result]
  (let [snapshot (snapshot-from-store-result store-result)]
    (and
     (state-verification? verification state)
     (snapshot? snapshot)
     (= state (get snapshot :state))
     (= (get verification :revision)
        (get snapshot :revision))
     (= (get verification :state-digest)
        (get snapshot :state-digest)))))

(defn commit-result?
  [transition-result verification store-result]
  (let [state (get transition-result :state)
        plan (transaction-plan transition-result)
        receipt (receipt-from-store-result store-result)]
    (and
     (commit-plan? plan state)
     (commit-verification-matches? verification plan state)
     (receipt-matches? receipt verification))))

(defn loaded-snapshot
  [store-result]
  (snapshot-from-store-result store-result))

(defn loaded-state
  [store-result]
  (let [snapshot (loaded-snapshot store-result)]
    (if (snapshot? snapshot)
      (get snapshot :state)
      nil)))
