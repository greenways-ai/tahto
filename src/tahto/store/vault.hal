(ns tahto.store.vault
  (:require [std.foundation :refer :all]
            [tahto.store.graph :as graph]
            [tahto.store.host :as store-host]
            [tahto.store.model :as model]))

(defn limits
  [state]
  (get state :limits))

(defn set-quota
  [state request]
  (let [application (get request :application)
        namespace (get request :namespace)
        quota-bytes (get request :quota-bytes)]
    (cond
      (not (model/identifier? application))
      (model/fail state "tahto.store/application-invalid")

      (not (model/identifier? namespace))
      (model/fail state "tahto.store/namespace-invalid")

      (not (model/non-negative-integer? quota-bytes))
      (model/fail state "tahto.store/quota-invalid")

      :else
      (let [accounting (graph/namespace-accounting state application namespace)]
        (if (not (get accounting :ok))
          accounting
          (let [used (get-in accounting [:value :bytes])
                reserved (model/namespace-reservations
                          state application namespace)]
            (if (> (+ used reserved) quota-bytes)
              (model/fail state "tahto.store/quota-below-usage"
                          {:quota quota-bytes
                           :used used
                           :reserved reserved})
              (let [key (model/namespace-key application namespace)
                    next-state
                    (assoc state :quotas
                           (assoc (get state :quotas) key quota-bytes))]
                (model/ok next-state
                          {:application application
                           :namespace namespace
                           :quota-bytes quota-bytes})))))))))

(defn begin-upload
  [state request]
  (let [upload-id (get request :upload-id)
        application (get request :application)
        namespace (get request :namespace)
        digest (get request :digest)
        size (get request :size)
        media-type (get request :media-type)]
    (cond
      (not (model/identifier? upload-id))
      (model/fail state "tahto.store/upload-id-invalid")

      (not (model/identifier? application))
      (model/fail state "tahto.store/application-invalid")

      (not (model/identifier? namespace))
      (model/fail state "tahto.store/namespace-invalid")

      (not (model/canonical-digest? digest))
      (model/fail state "tahto.store/digest-invalid" {:digest digest})

      (not (model/non-negative-integer? size))
      (model/fail state "tahto.store/size-invalid" {:size size})

      (> size (get (limits state) :max-object-bytes))
      (model/fail state "tahto.store/object-too-large" {:size size})

      (not (model/media-type? media-type))
      (model/fail state "tahto.store/media-type-invalid")

      (not (nil? (model/upload state upload-id)))
      (model/fail state "tahto.store/upload-exists" {:upload-id upload-id})

      (and (not (nil? (model/stored-object state digest)))
           (graph/namespace-reachable? state application namespace digest))
      (model/fail state "tahto.store/object-present" {:digest digest})

      :else
      (let [accounting (graph/namespace-accounting state application namespace)]
        (if (not (get accounting :ok))
          accounting
          (let [used (get-in accounting [:value :bytes])
                reserved (model/namespace-reservations
                          state application namespace)
                quota (model/namespace-quota state application namespace)]
            (if (> (+ used reserved size) quota)
              (model/fail state "tahto.store/quota-exceeded"
                          {:application application
                           :namespace namespace
                           :size size
                           :used used
                           :reserved reserved
                           :quota quota})
              (let [upload {:id upload-id
                            :application application
                            :namespace namespace
                            :digest digest
                            :size size
                            :media-type media-type
                            :offset 0
                            :status "open"}
                    next-state
                    (assoc state :uploads
                           (assoc (get state :uploads) upload-id upload))
                    effect (store-host/effect
                            "upload/open"
                            {:upload-id upload-id
                             :digest digest
                             :size size
                             :media-type media-type})]
                (model/ok next-state upload [effect])))))))))

(defn append-upload
  [state request]
  (let [upload-id (get request :upload-id)
        offset (get request :offset)
        length (get request :length)
        body-handle (get request :body-handle)
        upload (model/upload state upload-id)]
    (cond
      (nil? upload)
      (model/fail state "tahto.store/upload-missing" {:upload-id upload-id})

      (not (= "open" (get upload :status)))
      (model/fail state "tahto.store/upload-not-open" {:upload-id upload-id})

      (not (model/non-negative-integer? offset))
      (model/fail state "tahto.store/offset-invalid" {:offset offset})

      (not (= offset (get upload :offset)))
      (model/fail state "tahto.store/stale-upload-offset"
                  {:expected (get upload :offset)
                   :received offset})

      (not (model/positive-integer? length))
      (model/fail state "tahto.store/chunk-size-invalid" {:length length})

      (> length (get (limits state) :max-upload-chunk-bytes))
      (model/fail state "tahto.store/upload-chunk-too-large" {:length length})

      (> (+ offset length) (get upload :size))
      (model/fail state "tahto.store/upload-overflow"
                  {:offset offset
                   :length length
                   :size (get upload :size)})

      (not (model/positive-integer? body-handle))
      (model/fail state "tahto.store/body-handle-invalid")

      :else
      (let [updated (assoc upload :offset (+ offset length))
            next-state (assoc state :uploads
                              (assoc (get state :uploads) upload-id updated))
            effect (store-host/effect
                    "upload/append"
                    {:upload-id upload-id
                     :offset offset
                     :length length
                     :body-handle body-handle})]
        (model/ok next-state updated [effect])))))

(defn abort-upload
  [state request]
  (let [upload-id (get request :upload-id)
        upload (model/upload state upload-id)]
    (if (nil? upload)
      (model/fail state "tahto.store/upload-missing" {:upload-id upload-id})
      (model/ok
       (assoc state :uploads (dissoc (get state :uploads) upload-id))
       upload-id
       [(store-host/effect "upload/abort" {:upload-id upload-id})]))))

(defn request-install
  [state request]
  (let [upload-id (get request :upload-id)
        upload (model/upload state upload-id)]
    (cond
      (nil? upload)
      (model/fail state "tahto.store/upload-missing" {:upload-id upload-id})

      (not (= "open" (get upload :status)))
      (model/fail state "tahto.store/upload-not-open" {:upload-id upload-id})

      (not (= (get upload :offset) (get upload :size)))
      (model/fail state "tahto.store/upload-incomplete"
                  {:offset (get upload :offset)
                   :size (get upload :size)})

      :else
      (let [updated (assoc upload :status "verifying")
            next-state (assoc state :uploads
                              (assoc (get state :uploads) upload-id updated))
            effect (store-host/effect
                    "upload/verify-install"
                    {:upload-id upload-id
                     :digest (get upload :digest)
                     :size (get upload :size)})]
        (model/ok next-state updated [effect])))))

(defn accept-install
  [state host-result]
  (let [upload-id (get host-result :upload-id)
        upload (model/upload state upload-id)]
    (cond
      (nil? upload)
      (model/fail state "tahto.store/upload-missing" {:upload-id upload-id})

      (not (= "verifying" (get upload :status)))
      (model/fail state "tahto.store/upload-not-verifying" {:upload-id upload-id})

      (not (store-host/verified-install? host-result upload))
      (model/fail state "tahto.store/install-verification-failed"
                  {:upload-id upload-id})

      :else
      (let [digest (get upload :digest)
            candidate (model/object-record
                       digest
                       (get upload :size))
            existing (model/stored-object state digest)
            key (model/namespace-key
                 (get upload :application)
                 (get upload :namespace))
            references (model/value-or (get state :references) key #{})]
        (if (and (not (nil? existing))
                 (or (not (= (get existing :size) (get candidate :size)))
                     (not (= (get existing :encoding)
                             (get candidate :encoding)))))
          (model/fail state "tahto.store/object-metadata-conflict"
                      {:digest digest})
          (let [object (if (nil? existing) candidate existing)
                objects (assoc (get state :objects) digest object)
                next-state (assoc
                            (assoc
                             (assoc state :objects objects)
                             :uploads (dissoc (get state :uploads) upload-id))
                            :references
                            (assoc (get state :references)
                                   key
                                   (conj references digest)))]
            (model/ok next-state object)))))))

(defn detach-object
  [state request]
  (let [application (get request :application)
        namespace (get request :namespace)
        digest (get request :digest)
        key (model/namespace-key application namespace)
        references (model/value-or (get state :references) key #{})]
    (cond
      (not (model/identifier? application))
      (model/fail state "tahto.store/application-invalid")

      (not (model/identifier? namespace))
      (model/fail state "tahto.store/namespace-invalid")

      (not (model/canonical-digest? digest))
      (model/fail state "tahto.store/digest-invalid" {:digest digest})

      :else
      (let [updated (model/set-remove references digest)
            reference-map (if (empty? updated)
                            (dissoc (get state :references) key)
                            (assoc (get state :references) key updated))]
        (model/ok (assoc state :references reference-map) digest)))))

(defn negotiate
  [state request]
  (let [application (get request :application)
        namespace (get request :namespace)
        digests (get request :digests)]
    (cond
      (not (model/identifier? application))
      (model/fail state "tahto.store/application-invalid")

      (not (model/identifier? namespace))
      (model/fail state "tahto.store/namespace-invalid")

      (not (vector? digests))
      (model/fail state "tahto.store/digest-list-invalid")

      (> (count digests) (get (limits state) :max-negotiate-digests))
      (model/fail state "tahto.store/digest-list-too-large"
                  {:count (count digests)})

      (not (every? model/canonical-digest? digests))
      (model/fail state "tahto.store/digest-invalid")

      :else
      (let [report (graph/namespace-closure-report-value
                    state application namespace)]
        (if (get report :overflow)
          (model/fail state "tahto.store/namespace-closure-overflow"
                      {:application application :namespace namespace})
          (let [reachable (into #{} (get report :visited))
                ordered (distinct digests)
                result
                (reduce
                 (fn [output digest]
                   (if (and (has? reachable digest)
                            (not (nil? (model/stored-object state digest))))
                     (assoc output :present
                            (conj (get output :present) digest))
                     (assoc output :missing
                            (conj (get output :missing) digest))))
                 {:present [] :missing []}
                 ordered)]
            (model/ok state result)))))))

(defn plan-range
  [state request]
  (let [application (get request :application)
        namespace (get request :namespace)
        digest (get request :digest)
        start (get request :start)
        end (get request :end)
        object (model/stored-object state digest)]
    (cond
      (not (model/identifier? application))
      (model/fail state "tahto.store/application-invalid")

      (not (model/identifier? namespace))
      (model/fail state "tahto.store/namespace-invalid")

      (not (model/canonical-digest? digest))
      (model/fail state "tahto.store/digest-invalid" {:digest digest})

      (not (graph/namespace-reachable? state application namespace digest))
      (model/fail state "tahto.store/object-not-authorized" {:digest digest})

      (nil? object)
      (model/fail state "tahto.store/object-missing" {:digest digest})

      (not (model/non-negative-integer? start))
      (model/fail state "tahto.store/range-start-invalid" {:start start})

      (not (model/positive-integer? end))
      (model/fail state "tahto.store/range-end-invalid" {:end end})

      (>= start end)
      (model/fail state "tahto.store/range-order-invalid"
                  {:start start :end end})

      (> end (get object :size))
      (model/fail state "tahto.store/range-out-of-bounds"
                  {:end end :size (get object :size)})

      (> (- end start) (get (limits state) :max-range-bytes))
      (model/fail state "tahto.store/range-too-large"
                  {:length (- end start)})

      :else
      (model/ok
       state
       {:digest digest :start start :end end}
       [(store-host/effect
         "object/read-range"
         {:digest digest :start start :end end})]))))
