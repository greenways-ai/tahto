(ns tahto.store.capability
  (:require [std.foundation :refer :all]
            [std.foundation.coroutine :as coroutine]
            [std.foundation.host :as foundation-host]
            [tahto.store.host :as host]
            [tahto.store.model :as model]))

;; Tahto owns domain effects. This namespace maps those effects to an
;; application-neutral host capability without naming a native ABI in
;; application values. The installed host binds service identity to one trusted
;; provider descriptor.
(def host-service "hoplite.blob")
(def request-protocol "hoplite.blob-request/0-alpha")
(def result-protocol "hoplite.blob-result/0-alpha")

(def supported-effect-operations
  #{"upload/open"
    "upload/append"
    "upload/abort"
    "upload/verify-install"
    "object/read-range"})

(def capability-operations
  #{"probe"
    "staging/open"
    "staging/append-from-source"
    "staging/abort"
    "staging/verify-commit"
    "object/open-source"})

;; This shape mirrors `(std.foundation.host/call service operation request)`.
;; `std.foundation.host/call` packages the final request into the one-argument
;; vector crossing the Host/call boundary.
(def host-call-fields
  #{:service :operation :arguments})

(defn supported-effect?
  [effect]
  (and (host/effect? effect)
       (has? supported-effect-operations
             (get effect :operation))))

(defn capability-operation?
  [operation]
  (has? capability-operations operation))

(defn request-record
  [operation fields]
  (assoc
   (assoc fields :protocol request-protocol)
   :operation operation))

(defn request?
  [value]
  (and
   (host/record-safe? value)
   (= request-protocol (get value :protocol))
   (capability-operation? (get value :operation))
   (cond
     (= "probe" (get value :operation))
     (host/exact-keys? value #{:protocol :operation})

     (= "staging/open" (get value :operation))
     (and
      (host/exact-keys?
       value
       #{:protocol :operation :staging-key
         :expected-digest :expected-size :media-type})
      (model/identifier? (get value :staging-key))
      (model/canonical-digest? (get value :expected-digest))
      (model/non-negative-integer? (get value :expected-size))
      (model/media-type? (get value :media-type)))

     (= "staging/append-from-source" (get value :operation))
     (and
      (host/exact-keys?
       value
       #{:protocol :operation :staging-key
         :offset :length :source-handle})
      (model/identifier? (get value :staging-key))
      (model/non-negative-integer? (get value :offset))
      (model/positive-integer? (get value :length))
      (model/positive-integer? (get value :source-handle)))

     (= "staging/abort" (get value :operation))
     (and
      (host/exact-keys?
       value
       #{:protocol :operation :staging-key})
      (model/identifier? (get value :staging-key)))

     (= "staging/verify-commit" (get value :operation))
     (and
      (host/exact-keys?
       value
       #{:protocol :operation :staging-key
         :expected-digest :expected-size})
      (model/identifier? (get value :staging-key))
      (model/canonical-digest? (get value :expected-digest))
      (model/non-negative-integer? (get value :expected-size)))

     (= "object/open-source" (get value :operation))
     (and
      (host/exact-keys?
       value
       #{:protocol :operation :digest :offset :length})
      (model/canonical-digest? (get value :digest))
      (model/non-negative-integer? (get value :offset))
      (model/positive-integer? (get value :length)))

     :else false)))

(defn probe-request
  []
  (request-record "probe" {}))

(defn request-from-effect
  [effect]
  (if
   (supported-effect? effect)
   (let [operation (get effect :operation)
         request (get effect :request)]
     (cond
       (= operation "upload/open")
       (request-record
        "staging/open"
        {:staging-key (get request :upload-id)
         :expected-digest (get request :digest)
         :expected-size (get request :size)
         :media-type (get request :media-type)})

       (= operation "upload/append")
       (request-record
        "staging/append-from-source"
        {:staging-key (get request :upload-id)
         :offset (get request :offset)
         :length (get request :length)
         :source-handle (get request :body-handle)})

       (= operation "upload/abort")
       (request-record
        "staging/abort"
        {:staging-key (get request :upload-id)})

       (= operation "upload/verify-install")
       (request-record
        "staging/verify-commit"
        {:staging-key (get request :upload-id)
         :expected-digest (get request :digest)
         :expected-size (get request :size)})

       (= operation "object/read-range")
       (request-record
        "object/open-source"
        {:digest (get request :digest)
         :offset (get request :start)
         :length (- (get request :end)
                    (get request :start))})

       :else nil))
   nil))

(defn host-call
  [request]
  {:service host-service
   :operation (get request :operation)
   :arguments [request]})

(defn call-request
  [call]
  (get-in call [:arguments 0]))

(defn host-call?
  [value]
  (let [arguments (get value :arguments)
        request (call-request value)]
    (and
     (host/exact-keys? value host-call-fields)
     (= host-service (get value :service))
     (vector? arguments)
     (= 1 (count arguments))
     (request? request)
     (= (get value :operation)
        (get request :operation)))))

(defn call-from-effect
  [effect]
  (let [request (request-from-effect effect)]
    (if (request? request)
      (host-call request)
      nil)))

(defn prepare
  [state effect]
  (cond
    (not (host/effect? effect))
    (model/fail state "tahto.capability/effect-invalid")

    (not (supported-effect? effect))
    (model/fail state
                "tahto.capability/effect-unsupported"
                {:operation (get effect :operation)})

    :else
    (let [call (call-from-effect effect)]
      (if (host-call? call)
        (model/ok state call)
        (model/fail state
                    "tahto.capability/request-invalid"
                    {:operation (get effect :operation)})))))

(defn result?
  [value]
  (and
   (host/record-safe? value)
   (= result-protocol (get value :protocol))
   (capability-operation? (get value :operation))
   (cond
     (= "probe" (get value :operation))
     (and
      (host/exact-keys? value #{:protocol :operation :ready})
      (= true (get value :ready)))

     (= "staging/open" (get value :operation))
     (and
      (host/exact-keys?
       value
       #{:protocol :operation :staging-key :opened :offset})
      (model/identifier? (get value :staging-key))
      (= true (get value :opened))
      (model/non-negative-integer? (get value :offset)))

     (= "staging/append-from-source" (get value :operation))
     (and
      (host/exact-keys?
       value
       #{:protocol :operation :staging-key :consumed :offset :length})
      (model/identifier? (get value :staging-key))
      (= true (get value :consumed))
      (model/non-negative-integer? (get value :offset))
      (model/positive-integer? (get value :length)))

     (= "staging/abort" (get value :operation))
     (and
      (host/exact-keys?
       value
       #{:protocol :operation :staging-key :aborted})
      (model/identifier? (get value :staging-key))
      (= true (get value :aborted)))

     (= "staging/verify-commit" (get value :operation))
     (and
      (host/exact-keys?
       value
       #{:protocol :operation :staging-key :verified :committed
         :digest :size})
      (model/identifier? (get value :staging-key))
      (= true (get value :verified))
      (= true (get value :committed))
      (model/canonical-digest? (get value :digest))
      (model/non-negative-integer? (get value :size)))

     (= "object/open-source" (get value :operation))
     (and
      (host/exact-keys?
       value
       #{:protocol :operation :source-handle :digest :offset :length})
      (model/positive-integer? (get value :source-handle))
      (model/canonical-digest? (get value :digest))
      (model/non-negative-integer? (get value :offset))
      (model/positive-integer? (get value :length)))

     :else false)))

(defn result-matches-call?
  [call result]
  (and
   (host-call? call)
   (result? result)
   (= (get call :operation)
      (get result :operation))
   (let [operation (get call :operation)
         request (call-request call)]
     (cond
       (= operation "probe")
       true

       (= operation "staging/open")
       (and
        (= (get request :staging-key) (get result :staging-key))
        (<= (get result :offset) (get request :expected-size)))

       (= operation "staging/append-from-source")
       (and
        (= (get request :staging-key) (get result :staging-key))
        (= (get request :length) (get result :length))
        (= (+ (get request :offset) (get request :length))
           (get result :offset)))

       (= operation "staging/abort")
       (= (get request :staging-key) (get result :staging-key))

       (= operation "staging/verify-commit")
       (and
        (= (get request :staging-key) (get result :staging-key))
        (= (get request :expected-digest) (get result :digest))
        (= (get request :expected-size) (get result :size)))

       (= operation "object/open-source")
       (and
        (= (get request :digest) (get result :digest))
        (= (get request :offset) (get result :offset))
        (= (get request :length) (get result :length)))

       :else false))))

(defn accept-result
  [state call result]
  (cond
    (not (host-call? call))
    (model/fail state "tahto.capability/call-invalid")

    (not (result? result))
    (model/fail state
                "tahto.capability/result-invalid"
                {:operation (get call :operation)})

    (not (result-matches-call? call result))
    (model/fail state
                "tahto.capability/result-mismatch"
                {:operation (get call :operation)})

    :else
    (model/ok state result)))

(defn execute-call-with
  [state call invoke]
  (if
   (host-call? call)
   (accept-result
    state
    call
    (invoke
     (get call :service)
     (get call :operation)
     (call-request call)))
   (model/fail state "tahto.capability/call-invalid")))

(defn prepare-probe
  [state]
  (model/ok state (host-call (probe-request))))

(defn execute-probe-with
  [state invoke]
  (let [call (host-call (probe-request))]
    (execute-call-with state call invoke)))

(defn ^:async execute-probe
  [state]
  (let [call (host-call (probe-request))
        result
        (coroutine/await
         (foundation-host/call
          (get call :service)
          (get call :operation)
          (call-request call)))]
    (accept-result state call result)))

(defn execute-with
  [state effect invoke]
  (let [prepared (prepare state effect)]
    (if
     (get prepared :ok)
     (execute-call-with state (get prepared :value) invoke)
     prepared)))

(defn ^:async execute
  [state effect]
  (let [prepared (prepare state effect)]
    (if
     (get prepared :ok)
     (let [call (get prepared :value)
           result
           (coroutine/await
            (foundation-host/call
             (get call :service)
             (get call :operation)
             (call-request call)))]
       (accept-result state call result))
     prepared)))

(defn verified-install-result
  [effect result]
  (let [call (call-from-effect effect)]
    (if
     (and
      (= "upload/verify-install" (get effect :operation))
      (result-matches-call? call result))
     {:protocol host/result-protocol
      :operation "upload/verify-install"
      :verified true
      :installed true
      :upload-id (get-in effect [:request :upload-id])
      :digest (get result :digest)
      :size (get result :size)}
     nil)))

(defn opened-source-result
  [effect result]
  (let [call (call-from-effect effect)]
    (if
     (and
      (= "object/read-range" (get effect :operation))
      (result-matches-call? call result))
     {:protocol host/result-protocol
      :operation "object/read-range"
      :opened true
      :digest (get result :digest)
      :start (get-in effect [:request :start])
      :end (get-in effect [:request :end])
      :length (get result :length)
      :source-handle (get result :source-handle)}
     nil)))
