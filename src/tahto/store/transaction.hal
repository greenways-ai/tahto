(ns tahto.store.transaction
  (:require [std.foundation :refer :all]
            [tahto.protocol.validate :as validate]
            [tahto.store.model :as model]
            [tahto.sync.device :as device]))

(def transaction-protocol "tahto.metadata-transaction/1")
(def result-verification-protocol
  "tahto.transaction-result-verification/1")

(def result-outcomes
  #{"ok" "error"})

(def result-verification-fields
  #{:protocol :verified :operation :request-digest
    :outcome :result-digest :completed-at})

(defn current-revision
  [state]
  (model/value-or state :metadata-revision 0))

(defn result-verification?
  [value]
  (and
   (validate/exact-record? value result-verification-fields #{})
   (= result-verification-protocol (get value :protocol))
   (= true (get value :verified))
   (has? validate/device-operations (get value :operation))
   (model/canonical-digest? (get value :request-digest))
   (has? result-outcomes (get value :outcome))
   (model/canonical-digest? (get value :result-digest))
   (validate/timestamp? (get value :completed-at))))

(defn transition-result?
  [value]
  (and
   (map? value)
   (boolean? (get value :ok))
   (map? (get value :state))
   (vector? (get value :effects))
   (if (get value :ok)
     (and (has? value :value)
          (not (has? value :error)))
     (and (has? value :error)
          (map? (get value :error))
          (model/identifier? (get-in value [:error :code]))
          (not (has? value :value))))))

(defn expected-outcome
  [transition-result]
  (if (get transition-result :ok) "ok" "error"))

(defn verification-matches?
  [proof transition-result verification]
  (and
   (= (get proof :operation)
      (get verification :operation))
   (= (get proof :request-digest)
      (get verification :request-digest))
   (= (expected-outcome transition-result)
      (get verification :outcome))))

(defn completion
  [proof verification]
  {:device (get proof :device)
   :idempotency-key (get proof :idempotency-key)
   :request-digest (get proof :request-digest)
   :result-digest (get verification :result-digest)
   :completed-at (get verification :completed-at)})

(defn transaction-value
  [expected-revision revision context result result-digest replayed]
  {:protocol transaction-protocol
   :expected-revision expected-revision
   :revision revision
   :request-digest (get context :request-digest)
   :result-digest result-digest
   :context context
   :result result
   :replayed replayed})

(defn fail-original
  ([state code]
   (model/fail state code))
  ([state code details]
   (model/fail state code details)))

(defn execute
  [state expected-revision proof transition input verification]
  (let [revision (current-revision state)]
    (cond
      (not (model/non-negative-integer? revision))
      (fail-original state "tahto.transaction/revision-corrupt")

      (not (model/non-negative-integer? expected-revision))
      (fail-original state "tahto.transaction/expected-revision-invalid")

      (not (= revision expected-revision))
      (fail-original state
                     "tahto.transaction/revision-conflict"
                     {:expected expected-revision
                      :current revision})

      :else
      (let [authorized (device/authorize-request state proof)]
        (if (not (get authorized :ok))
          authorized
          (let [authorized-state (get authorized :state)
                context (get authorized :value)
                next-revision (inc expected-revision)]
            (if (= "completed" (get context :status))
              (let [next-state
                    (assoc authorized-state
                           :metadata-revision
                           next-revision)]
                (model/ok
                 next-state
                 (transaction-value
                  expected-revision
                  next-revision
                  context
                  nil
                  (get context :result-digest)
                  true)))
              (let [transition-result
                    (transition authorized-state context input)]
                (cond
                  (not (transition-result? transition-result))
                  (fail-original state
                                 "tahto.transaction/transition-result-invalid")

                  (not (empty? (get transition-result :effects)))
                  (fail-original state
                                 "tahto.transaction/effects-not-atomic"
                                 {:count (count (get transition-result :effects))})

                  (not (result-verification? verification))
                  (fail-original state
                                 "tahto.transaction/result-verification-invalid")

                  (not (verification-matches?
                        proof transition-result verification))
                  (fail-original state
                                 "tahto.transaction/result-verification-mismatch")

                  :else
                  (let [completion-state
                        (if (get transition-result :ok)
                          (get transition-result :state)
                          authorized-state)
                        completed
                        (device/complete-request
                         completion-state
                         (completion proof verification))]
                    (if (not (get completed :ok))
                      (fail-original state
                                     "tahto.transaction/completion-failed"
                                     {:cause (get completed :error)})
                      (let [completed-context (get completed :value)
                            next-state
                            (assoc (get completed :state)
                                   :metadata-revision
                                   next-revision)
                            value
                            (transaction-value
                             expected-revision
                             next-revision
                             completed-context
                             (if (get transition-result :ok)
                               (get transition-result :value)
                               (get transition-result :error))
                             (get verification :result-digest)
                             false)]
                        (if (get transition-result :ok)
                          (model/ok next-state value)
                          (assoc
                           (model/fail
                            next-state
                            (get-in transition-result [:error :code])
                            (get-in transition-result [:error :details]))
                           :transaction value))))))))))))))
